{
  "slug": "contact",
  "title": "Contact Us & Reach Our Himalayan Sanctuary",
  "html": "<main id=\"main-content\" class=\"w-full pt-28 bg-surface\"><div class=\"flex flex-col w-full\">\n<!-- Top Hero Visual Banner -->\n<section class=\"relative w-full overflow-hidden bg-primary text-linen-base\">\n<div class=\"relative h-[68vh] min-h-[520px] w-full flex items-end\">\n<!-- Panoramic Image with subtle ken burns effect -->\n<img fetchpriority=\"high\" decoding=\"async\" loading=\"eager\" alt=\"Panoramic view of Light of Landour Himalayan Sanctuary at golden hour with morning mist and stone path\" class=\"absolute inset-0 w-full h-full object-cover object-center transform scale-105 transition-transform duration-1000 ease-out\" src=\"/assets/d53b4e905fab3c37.webp\">\n<!-- Atmospheric Gradients: Dark pine fade & amber highlight -->\n<div class=\"absolute inset-0 bg-gradient-to-t from-primary via-primary/60 to-transparent\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-r from-primary/80 via-transparent to-transparent\"></div>\n<!-- Hero Content Container -->\n<div class=\"relative z-10 max-w-[1320px] mx-auto w-full px-6 pb-16 pt-32\">\n<div class=\"max-w-3xl flex flex-col gap-4\">\n<div class=\"inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-surface-container-lowest/15 backdrop-blur-md w-fit\">\n<span class=\"w-2 h-2 rounded-full bg-cedar-gold animate-pulse\"></span>\n<span class=\"text-label-sm font-label-sm uppercase tracking-[0.2em] text-linen-base\">Designed for Natural Living</span>\n</div>\n<h1 class=\"font-display text-display text-linen-base leading-[1.08] tracking-tight\">\n            Contact Us &amp; Connect With The Sanctuary\n          </h1>\n<p class=\"font-body-lg text-body-lg text-linen-subtle/90 max-w-2xl leading-relaxed\">\n            Tucked amidst ancient cedar canopies on Char Dukan ridge at 7,500 FT elevation. Whether you seek solitary writing residencies, private Himalayan dining at Juliet's Balcony, or holistic Ayurvedic recalibration, our resident caretakers are here to guide your ascent.\n          </p>\n</div>\n</div>\n</div>\n<!-- Sanctuary Status Strip -->\n<div class=\"w-full bg-pine-deep text-linen-base/90 py-4 px-6 shadow-md\">\n<div class=\"max-w-[1320px] mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-body-sm font-body-sm\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">explore</span>\n<div>\n<div class=\"text-label-sm font-label-sm uppercase text-mist-silver tracking-widest\">Sanctuary Coordinates</div>\n<div class=\"font-medium text-linen-base tracking-wide\">30.4598° N, 78.0934° E</div>\n</div>\n</div>\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">terrain</span>\n<div>\n<div class=\"text-label-sm font-label-sm uppercase text-mist-silver tracking-widest\">Altitude &amp; Location</div>\n<div class=\"font-medium text-linen-base tracking-wide\">7,500 FT • Char Dukan Ridge</div>\n</div>\n</div>\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">phone_in_talk</span>\n<div>\n<div class=\"text-label-sm font-label-sm uppercase text-mist-silver tracking-widest\">Direct Resident Concierge</div>\n<a class=\"font-medium text-linen-base hover:text-cedar-gold transition-colors tracking-wide\" href=\"tel:+919068555303\">+91 9068555303 (Tel &amp; WhatsApp)</a>\n</div>\n</div>\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">hourglass_top</span>\n<div>\n<div class=\"text-label-sm font-label-sm uppercase text-mist-silver tracking-widest\">Response Window</div>\n<div class=\"font-medium text-linen-base tracking-wide\">Guaranteed within 2 hours</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Main Interaction Area: Contact Grid & Sanctuary Inquiry Form -->\n<section class=\"max-w-[1320px] mx-auto w-full px-6 py-20 lg:py-28\">\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start\">\n<!-- Left Column: 4 Channels Cards & Ridge Atmosphere -->\n<div class=\"lg:col-span-5 flex flex-col gap-6\">\n<div class=\"flex flex-col gap-2 mb-2\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-[0.2em] text-cedar-gold\">Himalayan Hospitality</span>\n<h2 class=\"font-headline-lg text-headline-lg text-primary\">Direct Reach &amp; Enquiries</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n            Our caretakers are rooted on the ridge throughout all seasons—from golden autumn sunsets to snowbound winter silence. Choose your preferred medium of correspondence.\n          </p>\n</div>\n<!-- Card 1: Resident Phone & WhatsApp -->\n<div class=\"group p-6 rounded-xl bg-surface-container-low transition-all duration-300 hover:bg-surface-container hover:shadow-md\">\n<div class=\"flex items-start gap-4\">\n<div class=\"w-11 h-11 rounded-lg bg-primary-container text-cedar-gold flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[22px]\">perm_phone_msg</span>\n</div>\n<div class=\"flex flex-col gap-1\">\n<span class=\"text-label-sm font-label-sm uppercase text-cedar-gold tracking-wider\">Voice &amp; WhatsApp</span>\n<h3 class=\"font-headline-sm text-headline-sm text-primary\">Resident Concierge</h3>\n<a class=\"text-title-md font-title-md text-pine-deep hover:text-cedar-gold transition-colors my-1\" href=\"tel:+919068555303\">\n                +91-9068555303\n              </a>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant leading-relaxed\">\n                Available 24/7 for ridge navigation assistance, bespoke stay inquiries, and private pick-up coordination from Dehradun or Delhi.\n              </p>\n</div>\n</div>\n</div>\n<!-- Card 2: Sanctuary Desk & Correspondence -->\n<div class=\"group p-6 rounded-xl bg-surface-container-low transition-all duration-300 hover:bg-surface-container hover:shadow-md\">\n<div class=\"flex items-start gap-4\">\n<div class=\"w-11 h-11 rounded-lg bg-primary-container text-cedar-gold flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[22px]\">mail</span>\n</div>\n<div class=\"flex flex-col gap-1\">\n<span class=\"text-label-sm font-label-sm uppercase text-cedar-gold tracking-wider\">Formal Correspondence</span>\n<h3 class=\"font-headline-sm text-headline-sm text-primary\">Sanctuary Desk</h3>\n<a class=\"text-title-md font-title-md text-pine-deep hover:text-cedar-gold transition-colors my-1\" href=\"mailto:namaste@lightoflandour.com\">\n                namaste@lightoflandour.com\n              </a>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant leading-relaxed\">\n                For wellness package curations, artist residency proposals, Himalayan photography permits, and private event reservations.\n              </p>\n</div>\n</div>\n</div>\n<!-- Card 3: Authentic Physical Address -->\n<div class=\"group p-6 rounded-xl bg-surface-container-low transition-all duration-300 hover:bg-surface-container hover:shadow-md\">\n<div class=\"flex items-start gap-4\">\n<div class=\"w-11 h-11 rounded-lg bg-primary-container text-cedar-gold flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[22px]\">location_on</span>\n</div>\n<div class=\"flex flex-col gap-1\">\n<span class=\"text-label-sm font-label-sm uppercase text-cedar-gold tracking-wider\">Sanctuary Address</span>\n<h3 class=\"font-headline-sm text-headline-sm text-primary\">Ridge Landmark</h3>\n<p class=\"font-body-md text-body-md text-on-surface font-medium my-1\">\n                Property 35, Adjacent St. Paul's Church, Cantonment, Char Dukan, Landour, Mussoorie, Uttarakhand 248179\n              </p>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant leading-relaxed\">\n                Located right on the historic Char Dukan ridge, 200 meters from historic tea stalls and colonial trails.\n              </p>\n</div>\n</div>\n</div>\n<!-- Card 4: Social Community & Digital Hearth -->\n<div class=\"group p-6 rounded-xl bg-surface-container-low transition-all duration-300 hover:bg-surface-container hover:shadow-md\">\n<div class=\"flex items-start gap-4\">\n<div class=\"w-11 h-11 rounded-lg bg-primary-container text-cedar-gold flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform\">\n<span class=\"material-symbols-outlined text-[22px]\">hub</span>\n</div>\n<div class=\"flex flex-col gap-1\">\n<span class=\"text-label-sm font-label-sm uppercase text-cedar-gold tracking-wider\">Alpine Chronicles</span>\n<h3 class=\"font-headline-sm text-headline-sm text-primary\">Digital Hearth</h3>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant leading-relaxed my-1\">\n                Follow our seasonal vignettes, winter snowfall updates, and deodar mist chronicles on Instagram (<span class=\"text-pine-deep font-semibold\">@lightoflandour</span>), Facebook, and YouTube.\n              </p>\n<div class=\"flex items-center gap-3 pt-2\">\n<a data-demo-info=\"Instagram\" class=\"px-3 py-1 rounded bg-surface-container text-label-sm font-label-sm text-primary hover:bg-cedar-gold hover:text-linen-base transition-colors\" href=\"#inquiry\">Instagram</a>\n<a data-demo-info=\"Facebook\" class=\"px-3 py-1 rounded bg-surface-container text-label-sm font-label-sm text-primary hover:bg-cedar-gold hover:text-linen-base transition-colors\" href=\"#inquiry\">Facebook</a>\n<a data-demo-info=\"YouTube\" class=\"px-3 py-1 rounded bg-surface-container text-label-sm font-label-sm text-primary hover:bg-cedar-gold hover:text-linen-base transition-colors\" href=\"#inquiry\">YouTube</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Right Column: Interactive Concierge Form -->\n<div class=\"lg:col-span-7 bg-linen-subtle p-8 sm:p-10 lg:p-12 rounded-xl shadow-lg relative overflow-hidden\">\n<!-- Subtle botanical accent in corner -->\n<div class=\"absolute -right-8 -top-8 w-44 h-44 rounded-full bg-cedar-gold/5 blur-2xl pointer-events-none\"></div>\n<div class=\"flex flex-col gap-3 mb-8\">\n<div class=\"inline-flex items-center gap-2 text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold\">\n<span class=\"material-symbols-outlined text-[16px]\">edit_note</span>\n            Direct Caretaker Dispatch\n          </div>\n<h2 class=\"font-headline-lg text-headline-lg text-primary\">\n            Plan Your Himalayan Sojourn\n          </h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n            Share your dates and intention. Whether seeking solitary contemplation or a celebratory family mountain repast, we personally orchestrate each arrival.\n          </p>\n</div>\n<form data-demo-form=\"\" class=\"flex flex-col gap-6\" id=\"sanctuaryContactForm\">\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n<!-- Full Name -->\n<div class=\"flex flex-col gap-2\">\n<label class=\"text-label-md font-label-md uppercase tracking-wider text-pine-deep\" for=\"fullName\">\n                Full Name <span class=\"text-cedar-gold\">*</span>\n</label>\n<input aria-label=\"Full Name *\" class=\"w-full h-12 px-4 rounded bg-surface-container-lowest text-on-surface font-body-md text-body-md shadow-sm transition-all focus:outline-none focus:bg-linen-base\" id=\"fullName\" name=\"fullName\" placeholder=\"e.g. Alistair Sterling\" required type=\"text\">\n</div>\n<!-- Email Address -->\n<div class=\"flex flex-col gap-2\">\n<label class=\"text-label-md font-label-md uppercase tracking-wider text-pine-deep\" for=\"email\">\n                Email Address <span class=\"text-cedar-gold\">*</span>\n</label>\n<input aria-label=\"Email Address *\" class=\"w-full h-12 px-4 rounded bg-surface-container-lowest text-on-surface font-body-md text-body-md shadow-sm transition-all focus:outline-none focus:bg-linen-base\" id=\"email\" name=\"email\" placeholder=\"e.g. alistair@sanctuary.org\" required type=\"email\">\n</div>\n</div>\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n<!-- Phone / WhatsApp -->\n<div class=\"flex flex-col gap-2\">\n<label class=\"text-label-md font-label-md uppercase tracking-wider text-pine-deep\" for=\"phone\">\n                Phone / WhatsApp <span class=\"text-cedar-gold\">*</span>\n</label>\n<input aria-label=\"Phone / WhatsApp *\" class=\"w-full h-12 px-4 rounded bg-surface-container-lowest text-on-surface font-body-md text-body-md shadow-sm transition-all focus:outline-none focus:bg-linen-base\" id=\"phone\" name=\"phone\" placeholder=\"+91 98765 43210\" required type=\"tel\">\n</div>\n<!-- Planned Month / Dates of Visit -->\n<div class=\"flex flex-col gap-2\">\n<label class=\"text-label-md font-label-md uppercase tracking-wider text-pine-deep\" for=\"travelDates\">\n                Planned Dates or Month\n              </label>\n<input aria-label=\"Planned Dates or Month\" class=\"w-full h-12 px-4 rounded bg-surface-container-lowest text-on-surface font-body-md text-body-md shadow-sm transition-all focus:outline-none focus:bg-linen-base\" id=\"travelDates\" name=\"travelDates\" placeholder=\"e.g. Late October / 3 Nights\" type=\"text\">\n</div>\n</div>\n<!-- Area of Interest Dropdown -->\n<div class=\"flex flex-col gap-2\">\n<label class=\"text-label-md font-label-md uppercase tracking-wider text-pine-deep\" for=\"interest\">\n              Area of Interest\n            </label>\n<div class=\"relative\">\n<select aria-label=\"Choose preference\" class=\"w-full h-12 px-4 pr-10 rounded bg-surface-container-lowest text-on-surface font-body-md text-body-md shadow-sm appearance-none transition-all focus:outline-none focus:bg-linen-base\" id=\"interest\" name=\"interest\">\n<option value=\"mudra\">Mudra Duplex Suites (Valley &amp; Snow Range Views)</option>\n<option value=\"chakra\">Chakra Rooms &amp; Romantic Cedar Attic</option>\n<option value=\"element\">Element Cottages (Private Garden &amp; Fireplace)</option>\n<option value=\"dining\">The Glass Box Dining &amp; Juliet's Balcony Experience</option>\n<option value=\"wellness\">Spa, Sound Healing &amp; Ayurvedic Retreat</option>\n<option value=\"packages\">Curated 3N/4D Himalayan Stay Packages</option>\n<option value=\"residency\">Writing &amp; Creative Resident Inquiries</option>\n</select>\n<span class=\"material-symbols-outlined pointer-events-none absolute right-3.5 top-3.5 text-outline text-[20px]\">\n                expand_more\n              </span>\n</div>\n</div>\n<!-- Message / Story -->\n<div class=\"flex flex-col gap-2\">\n<label class=\"text-label-md font-label-md uppercase tracking-wider text-pine-deep\" for=\"message\">\n              How Can We Help You? / Paint a Picture of Your Himalayan Stay\n            </label>\n<textarea aria-label=\"How Can We Help You? / Paint a Picture of Your Himalayan Stay\" class=\"w-full p-4 rounded bg-surface-container-lowest text-on-surface font-body-md text-body-md shadow-sm transition-all focus:outline-none focus:bg-linen-base resize-none\" id=\"message\" name=\"message\" placeholder=\"Tell us about special dietary preferences, quiet working desk needs, porterage requests, or romantic setups...\" rows=\"4\"></textarea>\n</div>\n<!-- CTA and Guarantees -->\n<div class=\"flex flex-col gap-4 pt-2\">\n<button aria-label=\"Send Sanctuary Message send\" class=\"group relative w-full sm:w-auto self-start flex items-center justify-center gap-3 px-9 py-3.5 rounded bg-pine-deep text-linen-base font-label-md text-label-md uppercase tracking-[0.16em] hover:bg-pine-muted transition-all duration-300 shadow-md hover:shadow-lg\" id=\"submitBtn\" type=\"submit\">\n<span>Send Sanctuary Message</span>\n<span class=\"material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform\">send</span>\n</button>\n<!-- Success Feedback Notice (Hidden by default) -->\n<div class=\"hidden p-4 rounded bg-pine-deep text-linen-base text-body-sm font-body-sm items-center gap-3\" id=\"formFeedback\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">check_circle</span>\n<span>Namaste. Your sanctuary note has reached our resident caretaker desk. We shall revert via WhatsApp and email within 2 hours.</span>\n</div>\n<!-- Sanctuary Guarantees -->\n<div class=\"pt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-on-surface-variant\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[16px]\">verified</span>\n<span class=\"text-label-sm font-label-sm uppercase\">Direct Rate Privilege</span>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[16px]\">bedtime</span>\n<span class=\"text-label-sm font-label-sm uppercase\">10 PM Silence Policy</span>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[16px]\">security</span>\n<span class=\"text-label-sm font-label-sm uppercase\">Zero Spam Pledge</span>\n</div>\n</div>\n</div>\n<p class=\"demo-note\">Demo inquiry only. No message or reservation will be sent.</p></form>\n</div>\n</div>\n</section>\n<!-- Cinematic Audio-Visual Sanctuary Module -->\n<section class=\"w-full bg-slate-charcoal text-linen-base py-20 lg:py-24\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n<!-- Left: Context & Audio Metadata -->\n<div class=\"lg:col-span-5 flex flex-col gap-6\">\n<div class=\"inline-flex items-center gap-2 px-3 py-1 rounded bg-linen-base/10 w-fit text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold\">\n<span class=\"material-symbols-outlined text-[15px] animate-spin\">graphic_eq</span>\n            The Sounds of the Ridge\n          </div>\n<h2 class=\"font-headline-lg text-headline-lg text-linen-base leading-tight\">\n            Audio-Visual Guide to Landour Heights\n          </h2>\n<p class=\"font-body-md text-body-md text-mist-silver leading-relaxed\">\n            Pause and listen. The acoustic atmosphere at 7,500 FT is defined by wind whistling through deodar pine needles, morning temple chimes from Char Dukan, and distant Himalayan snow thaws.\n          </p>\n<div class=\"p-5 rounded-lg bg-white/5 backdrop-blur-sm flex flex-col gap-3\">\n<div class=\"flex items-center justify-between text-body-sm font-body-sm\">\n<span class=\"text-mist-silver\">Acoustic Signature</span>\n<span class=\"text-cedar-gold font-medium\">432Hz Himalayan Wind &amp; Singing Chimes</span>\n</div>\n<!-- Progress Bar -->\n<div class=\"w-full h-1.5 bg-white/10 rounded-full overflow-hidden\">\n<div class=\"h-full bg-cedar-gold rounded-full w-[45%] transition-all duration-300\" id=\"audioProgressBar\"></div>\n</div>\n<div class=\"flex items-center justify-between text-label-sm font-label-sm text-mist-silver\">\n<span id=\"timeDisplay\">02:10</span>\n<span>04:45</span>\n</div>\n</div>\n<div class=\"flex items-center gap-4\">\n<button aria-label=\"pause Pause Soundscape\" type=\"button\" class=\"flex items-center gap-3 px-6 py-3 rounded bg-cedar-gold text-slate-charcoal font-label-md text-label-md uppercase tracking-wider hover:bg-secondary-fixed transition-colors\" id=\"audioToggleBtn\">\n<span class=\"material-symbols-outlined text-[20px]\" id=\"audioIcon\">pause</span>\n<span id=\"audioBtnText\">Pause Soundscape</span>\n</button>\n<span class=\"text-body-sm font-body-sm text-mist-silver\">Binaural Mountain Stereo</span>\n</div>\n</div>\n<!-- Right: Video Frame with Backdrop -->\n<div class=\"lg:col-span-7\">\n<div class=\"relative aspect-video rounded-xl overflow-hidden shadow-2xl group\">\n<img decoding=\"async\" loading=\"lazy\" alt=\"Landour terrace overlooking snow peaks with meditators in early morning sun\" class=\"w-full h-full object-cover transform group-hover:scale-102 transition-transform duration-700\" src=\"/assets/3f79a8bf86954d23.webp\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-slate-charcoal via-slate-charcoal/30 to-transparent\"></div>\n<!-- Center Play Button Overlay -->\n<div class=\"absolute inset-0 flex items-center justify-center\">\n<button type=\"button\" aria-label=\"Play Himalayan Audio Tour\" class=\"w-20 h-20 rounded-full bg-linen-base/90 text-primary flex items-center justify-center backdrop-blur-md shadow-xl hover:scale-110 hover:bg-cedar-gold hover:text-linen-base transition-all duration-300\">\n<span class=\"material-symbols-outlined text-[36px] ml-1\" id=\"playOverlayIcon\">volume_up</span>\n</button>\n</div>\n<!-- Bottom Left Badge -->\n<div class=\"absolute bottom-6 left-6 right-6 flex items-center justify-between pointer-events-none\">\n<div class=\"flex items-center gap-2 px-3 py-1.5 rounded bg-slate-charcoal/80 backdrop-blur-md text-linen-base text-label-sm font-label-sm\">\n<span class=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\"></span>\n<span>Live Audio Feed • Char Dukan Weather Station</span>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-cedar-gold bg-slate-charcoal/80 px-2.5 py-1 rounded backdrop-blur-md\">\n                12°C Crisp\n              </span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- How to Reach & Ridge Navigation Itinerary -->\n<section class=\"max-w-[1320px] mx-auto w-full px-6 py-20 lg:py-28\">\n<div class=\"flex flex-col gap-4 text-center max-w-2xl mx-auto mb-16\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-[0.2em] text-cedar-gold\">Himalayan Approach</span>\n<h2 class=\"font-headline-lg text-headline-lg text-primary\">How to Reach Our Sanctuary</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n        Ascending to Landour is a poetic transition from the bustling Doon plains into pristine deodar woodlands. Here are authentic route calculations and walking distances.\n      </p>\n</div>\n<!-- 2 Column Split: Key Transit Hubs & Walking Trails from the Ridge -->\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mb-16\">\n<!-- Box 1: Regional Connectivity & Drives -->\n<div class=\"p-8 rounded-xl bg-surface-container-low flex flex-col gap-6\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-lg bg-pine-deep text-linen-base flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[20px]\">directions_car</span>\n</div>\n<div>\n<h3 class=\"font-headline-sm text-headline-sm text-primary\">By Air &amp; Rail</h3>\n<span class=\"text-label-sm font-label-sm text-on-surface-variant\">Regional transfers to 7,500 FT</span>\n</div>\n</div>\n<div class=\"flex flex-col gap-4 divide-y divide-linen-border/60\">\n<div class=\"pt-3 first:pt-0 flex items-start justify-between gap-4\">\n<div>\n<div class=\"font-title-md text-title-md text-on-surface\">Jolly Grant Airport, Dehradun (DED)</div>\n<div class=\"text-body-sm font-body-sm text-on-surface-variant\">Nonstop flights from Delhi, Mumbai, Bengaluru, and Jaipur</div>\n</div>\n<div class=\"text-right shrink-0\">\n<span class=\"font-semibold text-pine-deep text-title-md\">64 KM</span>\n<div class=\"text-label-sm font-label-sm text-cedar-gold\">2.5 Hrs Scenic Drive</div>\n</div>\n</div>\n<div class=\"pt-4 flex items-start justify-between gap-4\">\n<div>\n<div class=\"font-title-md text-title-md text-on-surface\">Dehradun Railway Station</div>\n<div class=\"text-body-sm font-body-sm text-on-surface-variant\">Vande Bharat, Shatabdi &amp; overnight express coaches</div>\n</div>\n<div class=\"text-right shrink-0\">\n<span class=\"font-semibold text-pine-deep text-title-md\">38 KM</span>\n<div class=\"text-label-sm font-label-sm text-cedar-gold\">1.5 Hrs Ascent</div>\n</div>\n</div>\n<div class=\"pt-4 flex items-start justify-between gap-4\">\n<div>\n<div class=\"font-title-md text-title-md text-on-surface\">Mussoorie Mall Road (Picture Palace / Library)</div>\n<div class=\"text-body-sm font-body-sm text-on-surface-variant\">Main hill station center; ascent via Upper Mall road</div>\n</div>\n<div class=\"text-right shrink-0\">\n<span class=\"font-semibold text-pine-deep text-title-md\">3.3 KM</span>\n<div class=\"text-label-sm font-label-sm text-cedar-gold\">15 Mins Drive</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Box 2: Ridge & Local Heritage Walking Reach -->\n<div class=\"p-8 rounded-xl bg-surface-container-low flex flex-col gap-6\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-lg bg-pine-deep text-linen-base flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[20px]\">hiking</span>\n</div>\n<div>\n<h3 class=\"font-headline-sm text-headline-sm text-primary\">Ridge Strolls &amp; Landmarks</h3>\n<span class=\"text-label-sm font-label-sm text-on-surface-variant\">Walking from our doorstep</span>\n</div>\n</div>\n<div class=\"flex flex-col gap-4 divide-y divide-linen-border/60\">\n<div class=\"pt-3 first:pt-0 flex items-start justify-between gap-4\">\n<div>\n<div class=\"font-title-md text-title-md text-on-surface\">St. Paul's Church (Built 1839)</div>\n<div class=\"text-body-sm font-body-sm text-on-surface-variant\">Historic stone Anglican sanctuary under towering pines</div>\n</div>\n<div class=\"text-right shrink-0\">\n<span class=\"font-semibold text-pine-deep text-title-md\">Adjacent</span>\n<div class=\"text-label-sm font-label-sm text-cedar-gold\">1 Min Walk</div>\n</div>\n</div>\n<div class=\"pt-4 flex items-start justify-between gap-4\">\n<div>\n<div class=\"font-title-md text-title-md text-on-surface\">Char Dukan Vintage Tea Stalls</div>\n<div class=\"text-body-sm font-body-sm text-on-surface-variant\">Legendary ginger lemon tea, cinnamon waffles &amp; mountain lore</div>\n</div>\n<div class=\"text-right shrink-0\">\n<span class=\"font-semibold text-pine-deep text-title-md\">200 M</span>\n<div class=\"text-label-sm font-label-sm text-cedar-gold\">2 Mins Walk</div>\n</div>\n</div>\n<div class=\"pt-4 flex items-start justify-between gap-4\">\n<div>\n