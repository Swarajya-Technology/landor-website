  "title": "Element Rooms & European Courtyard Cottages",
  "html": "<main id=\"main-content\" class=\"w-full pt-28 bg-surface\"><div class=\"flex flex-col w-full\">\n<!-- Top Hero Section: Authentic European Courtyard Architecture & Panorama -->\n<section class=\"relative w-full overflow-hidden bg-linen-base\">\n<div class=\"max-w-[1320px] mx-auto px-6 pt-6 pb-16\">\n<!-- Editorial Overline & Badge System -->\n<div class=\"flex flex-wrap items-center justify-between gap-4 mb-6\">\n<div class=\"flex items-center gap-2\">\n<span class=\"px-3 py-1 bg-surface-container text-pine-deep text-label-sm font-label-sm uppercase tracking-widest rounded-lg\">\n            Elements • Pancha Mahabhuta\n          </span>\n<span class=\"px-3 py-1 bg-secondary-container/40 text-on-secondary-fixed text-label-sm font-label-sm uppercase tracking-widest rounded-lg flex items-center gap-1.5\">\n<span class=\"material-symbols-outlined text-[14px] text-cedar-gold\">terrain</span>\n            7,500 FT Elevation\n          </span>\n</div>\n<div class=\"hidden sm:flex items-center gap-2 text-label-sm font-label-sm uppercase tracking-widest text-on-surface-variant\">\n<span>Char Dukan Ridge</span>\n<span>•</span>\n<span>Himalayan Heritage Suite</span>\n</div>\n</div>\n<!-- Main Asymmetric Hero Stage -->\n<div class=\"relative rounded-2xl overflow-hidden shadow-2xl bg-slate-charcoal\">\n<div class=\"relative w-full h-[580px] lg:h-[680px]\">\n<img fetchpriority=\"high\" decoding=\"async\" loading=\"eager\" class=\"w-full h-full object-cover brightness-95 transform scale-100 hover:scale-105 transition-transform duration-1000 ease-out\" data-alt=\"Stunning architectural view from stone arches of Light of Landour European courtyard cottage at 7500 feet elevation with rustic stone buildings, dark slate roofs, hanging wooden plaque reading Light of Landour, potted plants, deep green Himalayan deodar forest and mist filled mountain valley in golden morning light\" src=\"/assets/7ac8e6514dcc4eb5.webp\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-slate-charcoal/95 via-slate-charcoal/40 to-transparent\"></div>\n<div class=\"absolute top-8 right-8 hidden md:flex items-center gap-3 px-4 py-2 bg-linen-base/90 backdrop-blur-md rounded-xl shadow-lg\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">balcony</span>\n<div class=\"flex flex-col\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-pine-deep font-semibold\">Special Feature</span>\n<span class=\"text-body-sm font-body-sm text-on-surface\">Private Outside Veranda &amp; Tea Deck</span>\n</div>\n</div>\n<!-- Bottom Floating Content inside Hero -->\n<div class=\"absolute bottom-0 inset-x-0 p-8 lg:p-14 flex flex-col justify-end text-linen-base\">\n<div class=\"max-w-3xl\">\n<span class=\"text-label-md font-label-md uppercase tracking-[0.25em] text-secondary-container mb-3 inline-block\">\n                European Courtyard Cottages\n              </span>\n<h1 class=\"font-display text-headline-lg lg:text-display text-linen-base tracking-tight leading-none mb-4\">\n                The Magic Is in The Moment\n              </h1>\n<p class=\"font-body-lg text-body-md lg:text-body-lg text-linen-base/90 font-normal leading-relaxed max-w-2xl mb-8\">\n                Take in the beauty that surrounds you. Take a deep breath and allow the universe to nurture you. Every space in Light of Landour European Courtyard Cottages is filled with charm and comfort. The space is well lit and the beauty of Landour is visible from the comfort of the rooms.\n              </p>\n<!-- Quick Action Cluster -->\n<div class=\"flex flex-wrap items-center gap-4\">\n<a class=\"px-7 py-3.5 bg-pine-deep hover:bg-pine-muted text-linen-base font-label-md text-label-md uppercase tracking-widest rounded-lg shadow-lg hover:shadow-xl transition-all flex items-center gap-2\" href=\"#booking-inquiry\">\n<span>Check Availability</span>\n<span class=\"material-symbols-outlined text-[16px]\">calendar_month</span>\n</a>\n<a class=\"px-6 py-3.5 bg-linen-base/20 hover:bg-linen-base/30 text-linen-base backdrop-blur-md font-label-md text-label-md uppercase tracking-widest rounded-lg transition-all flex items-center gap-2\" href=\"#audiovisual-tour\">\n<span class=\"material-symbols-outlined text-[18px] text-secondary-container\">play_circle</span>\n<span>Watch Cottage Tour</span>\n</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Specification Architectural Ribbon (5 Metric Monolith) -->\n<div class=\"relative -mt-10 max-w-[1240px] mx-auto z-10 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 p-4 bg-linen-subtle/95 backdrop-blur-xl rounded-2xl shadow-xl\">\n<div class=\"p-4 bg-surface rounded-xl flex flex-col\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-outline mb-1\">Cottage Capacity</span>\n<span class=\"text-title-md font-title-md text-pine-deep\">2 Adults &amp; Children</span>\n<span class=\"text-body-sm font-body-sm text-on-surface-variant mt-0.5\">Family extra bed on request</span>\n</div>\n<div class=\"p-4 bg-surface rounded-xl flex flex-col\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-outline mb-1\">Bedding Craft</span>\n<span class=\"text-title-md font-title-md text-pine-deep\">1 King Size Bed</span>\n<span class=\"text-body-sm font-body-sm text-on-surface-variant mt-0.5\">Handcrafted solid cedar frame</span>\n</div>\n<div class=\"p-4 bg-surface rounded-xl flex flex-col\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-outline mb-1\">Spatial Layout</span>\n<span class=\"text-title-md font-title-md text-pine-deep\">Bedroom + Veranda</span>\n<span class=\"text-body-sm font-body-sm text-on-surface-variant mt-0.5\">Covered private seating patio</span>\n</div>\n<div class=\"p-4 bg-surface rounded-xl flex flex-col\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-outline mb-1\">Floor Plan Size</span>\n<span class=\"text-title-md font-title-md text-pine-deep\">12 × 20 sq. ft.</span>\n<span class=\"text-body-sm font-body-sm text-on-surface-variant mt-0.5\">+ Exterior courtyard gallery</span>\n</div>\n<div class=\"col-span-2 md:col-span-1 p-4 bg-primary-container text-linen-base rounded-xl flex flex-col justify-between\">\n<div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-cedar-gold mb-1 block\">Sanctuary Tariff</span>\n<div class=\"flex items-baseline gap-1\">\n<span class=\"text-title-lg font-title-lg font-bold text-linen-base\">₹10,500</span>\n<span class=\"text-body-sm font-body-sm text-linen-base/70\">/ night</span>\n</div>\n</div>\n<span class=\"text-[11px] font-label-sm uppercase text-secondary-container mt-2\">Organic Breakfast Included</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Architectural Seclusion & Gallery Mosaic -->\n<section class=\"w-full py-20 bg-surface\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16\">\n<div class=\"lg:col-span-7 flex flex-col gap-4\">\n<div class=\"inline-flex items-center gap-2\">\n<span class=\"w-8 h-[1px] bg-cedar-gold\"></span>\n<span class=\"text-label-md font-label-md uppercase tracking-widest text-pine-deep\">A Place of Natural Harmony</span>\n</div>\n<h2 class=\"font-headline-lg text-headline-lg text-primary tracking-tight leading-tight\">\n            Unparalleled Seclusion and Privacy to Release, Refocus and Recalibrate the Self\n          </h2>\n<p class=\"text-body-md font-body-md text-on-surface-variant leading-relaxed\">\n            The spacious suites are crafted in harmony with the beautiful natural terrain. You know that every time you step out, you have the most comfortable environment to pamper you when you get back. Make the most of the in-room facilities that are state-of-the-art and attuned to your entertainment requirements. Ample storage space with a wardrobe all designed with ergonomics in mind.\n          </p>\n<div class=\"flex flex-wrap items-center gap-6 pt-4 text-body-sm font-body-sm text-on-surface\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">spa</span>\n<span>Pancha Mahabhuta Alignment</span>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">local_cafe</span>\n<span>Artisanal Mountain Teas</span>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">wifi</span>\n<span>Fiber Optical High-Speed</span>\n</div>\n</div>\n</div>\n<div class=\"lg:col-span-5 bg-surface-container-low p-8 rounded-2xl shadow-sm flex flex-col gap-6\">\n<div class=\"flex items-center justify-between\">\n<span class=\"text-label-md font-label-md uppercase tracking-wider text-pine-deep font-semibold\">Architectural Metrics</span>\n<span class=\"material-symbols-outlined text-pine-muted\">architecture</span>\n</div>\n<div class=\"space-y-4\">\n<div class=\"flex justify-between items-center pb-3\">\n<span class=\"text-body-sm font-body-sm text-on-surface-variant\">Master Element Suite Area</span>\n<span class=\"text-body-md font-body-md font-medium text-on-surface\">12 × 20 sq. ft.</span>\n</div>\n<div class=\"flex justify-between items-center pb-3\">\n<span class=\"text-body-sm font-body-sm text-on-surface-variant\">Covered Private Seating Patio</span>\n<span class=\"text-body-md font-body-md font-medium text-on-surface\">8 × 12 sq. ft.</span>\n</div>\n<div class=\"flex justify-between items-center pb-3\">\n<span class=\"text-body-sm font-body-sm text-on-surface-variant\">Panoramic Valley Balcony</span>\n<span class=\"text-body-md font-body-md font-medium text-on-surface\">6 × 10 sq. ft.</span>\n</div>\n<div class=\"flex justify-between items-center\">\n<span class=\"text-body-sm font-body-sm text-on-surface-variant\">Restroom &amp; Rain Shower</span>\n<span class=\"text-body-md font-body-md font-medium text-on-surface\">6 × 9 sq. ft.</span>\n</div>\n</div>\n<div class=\"p-4 bg-linen-base rounded-xl text-body-sm font-body-sm text-on-surface-variant flex items-start gap-3\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px] shrink-0 mt-0.5\">verified</span>\n<span>Every window captures either the morning sunrise over the Garhwal peaks or the timeless deodars framing Char Dukan.</span>\n</div>\n</div>\n</div>\n<!-- Bento Visual Imagery Grid -->\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-6\">\n<!-- Image 1: Cottage Bedroom Interior -->\n<div class=\"md:col-span-7 group relative overflow-hidden rounded-2xl shadow-md h-96\">\n<img decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out\" data-alt=\"Cozy Himalayan cottage bedroom interior with whitewashed exposed brick wall, polished wooden bed with plush linen, patterned botanical throw, framed classical artwork, natural wood timber door, and warm ambient bedside lamp\" src=\"/assets/60378253531c422b.webp\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-slate-charcoal/80 via-transparent to-transparent\"></div>\n<div class=\"absolute bottom-6 left-6 right-6 text-linen-base\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-secondary-container\">Bedroom Chamber</span>\n<h3 class=\"text-headline-sm font-headline-sm text-linen-base\">Himalayan White Brick &amp; Hand-hewn Cedar</h3>\n</div>\n</div>\n<!-- Image 2: Mountain Tea Deck -->\n<div class=\"md:col-span-5 group relative overflow-hidden rounded-2xl shadow-md h-96\">\n<img decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out\" data-alt=\"Ceramic marble patterned tea cup and saucer resting on outdoor wooden balcony railing overlooking vast panoramic green pine covered mountain slope and distant hazy mountain ridges under a clear blue alpine sky\" src=\"/assets/d4a8ba759ee4b71e.webp\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-slate-charcoal/80 via-transparent to-transparent\"></div>\n<div class=\"absolute bottom-6 left-6 right-6 text-linen-base\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-secondary-container\">Private Veranda Morning</span>\n<h3 class=\"text-headline-sm font-headline-sm text-linen-base\">Fresh Brew Over the Forest Canopy</h3>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Audio-Visual Sanctuary: Elements in Motion -->\n<section class=\"w-full py-20 bg-surface-container-high\" id=\"audiovisual-tour\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"flex flex-col md:flex-row items-start md:items-end justify-between gap-6 mb-12\">\n<div>\n<span class=\"text-label-md font-label-md uppercase tracking-[0.2em] text-pine-deep block mb-2\">Immersive Media Experience</span>\n<h2 class=\"font-headline-lg text-headline-lg text-primary tracking-tight\">\n            The Elements in Motion — Audio-Visual Cottage Tour\n          </h2>\n</div>\n<div class=\"flex items-center gap-3 px-4 py-2 bg-surface rounded-full shadow-sm\">\n<span class=\"w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse\"></span>\n<span class=\"text-body-sm font-body-sm text-on-surface font-medium\">432Hz Himalayan Wind &amp; Deodar Soundscape</span>\n</div>\n</div>\n<div class=\"relative w-full rounded-2xl overflow-hidden shadow-2xl bg-slate-charcoal aspect-video lg:h-[540px]\">\n<img decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover opacity-80\" data-alt=\"Cinematic wide view of Light of Landour stone cottages framed by archways with glowing warm courtyard lights, pine trees silhouetted against twilight sky and distant mountain valley clouds\" src=\"/assets/75a79b0e1d1f8b18.webp\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-slate-charcoal/90 via-slate-charcoal/20 to-transparent\"></div>\n<!-- Interactive Player HUD -->\n<div class=\"absolute inset-0 flex flex-col justify-between p-6 md:p-10\">\n<div class=\"flex items-center justify-between\">\n<span class=\"px-3 py-1 bg-surface/20 backdrop-blur-md text-linen-base text-label-sm font-label-sm uppercase tracking-wider rounded-lg\">\n              Cinematic Retrospective • 4K HDR\n            </span>\n<button aria-label=\"volume_up Ambient Audio Active\" type=\"button\" class=\"flex items-center gap-2 px-3 py-1.5 bg-surface/20 hover:bg-surface/30 backdrop-blur-md text-linen-base rounded-full text-body-sm font-body-sm transition-colors\" id=\"soundscape-btn\">\n<span class=\"material-symbols-outlined text-[18px]\">volume_up</span>\n<span id=\"soundscape-label\">Ambient Audio Active</span>\n</button>\n</div>\n<div class=\"flex flex-col items-center justify-center my-auto\">\n<button aria-label=\"play_arrow\" type=\"button\" class=\"w-20 h-20 rounded-full bg-linen-base text-pine-deep flex items-center justify-center shadow-2xl hover:scale-110 transition-transform duration-300\" id=\"play-pause-btn\">\n<span class=\"material-symbols-outlined text-[40px] ml-1\">play_arrow</span>\n</button>\n<span class=\"text-label-md font-label-md uppercase tracking-widest text-linen-base/90 mt-4\">Experience Cottage Silence &amp; Echoes</span>\n</div>\n<!-- Timeline Controls -->\n<div class=\"w-full bg-surface/20 backdrop-blur-md p-4 rounded-xl flex flex-col gap-2\">\n<div class=\"w-full bg-linen-base/30 h-1.5 rounded-full overflow-hidden cursor-pointer\">\n<div class=\"bg-secondary-container h-full w-2/5 rounded-full\"></div>\n</div>\n<div class=\"flex items-center justify-between text-body-sm font-body-sm text-linen-base\">\n<span class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[16px] text-secondary-container\">tune</span>\n                Char Dukan Mountain Ridge Winds &amp; Forest Birds\n              </span>\n<span class=\"font-mono text-xs\">02:15 / 05:00</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- The Five Sacred Elements (Pancha Mahabhuta) Spatial Guide -->\n<section class=\"w-full py-24 bg-linen-base\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"text-center max-w-3xl mx-auto mb-16\">\n<span class=\"text-label-md font-label-md uppercase tracking-[0.25em] text-cedar-gold block mb-3\">\n          Holistic Himalayan Philosophy\n        </span>\n<h2 class=\"font-headline-lg text-headline-lg text-primary tracking-tight mb-4\">\n          The Five Sacred Elements in Residence\n        </h2>\n<p class=\"text-body-md font-body-md text-on-surface-variant leading-relaxed\">\n          Inspired by ancient Vedic teachings of the <em>Pancha Mahabhuta</em>, each European Courtyard cottage harmonizes physical matter and sensory consciousness with the high-altitude surroundings.\n        </p>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6\">\n<!-- Element 1: Earth -->\n<div class=\"p-6 bg-surface rounded-2xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group\">\n<div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-pine-deep mb-5 group-hover:bg-primary group-hover:text-on-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[24px]\">landscape</span>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold\">Prithvi</span>\n<h3 class=\"text-title-lg font-title-lg text-primary mt-1 mb-3\">Earth</h3>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant leading-relaxed\">\n              Grounding local slate foundations, exposed white-washed brick, and hand-carved deodar timber providing stability.\n            </p>\n</div>\n<div class=\"pt-6 mt-4 border-t-0 flex items-center gap-2 text-label-sm font-label-sm uppercase tracking-wider text-outline group-hover:text-pine-deep\">\n<span>Room Bed &amp; Floor</span>\n<span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</div>\n</div>\n<!-- Element 2: Water -->\n<div class=\"p-6 bg-surface rounded-2xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group\">\n<div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-pine-deep mb-5 group-hover:bg-primary group-hover:text-on-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[24px]\">water_drop</span>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold\">Jal</span>\n<h3 class=\"text-title-lg font-title-lg text-primary mt-1 mb-3\">Water</h3>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant leading-relaxed\">\n              Pristine mountain spring water, botanical restorative rain showers, and calming views of mist rolling through the hills.\n            </p>\n</div>\n<div class=\"pt-6 mt-4 border-t-0 flex items-center gap-2 text-label-sm font-label-sm uppercase tracking-wider text-outline group-hover:text-pine-deep\">\n<span>Rain Shower &amp; Tea</span>\n<span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</div>\n</div>\n<!-- Element 3: Fire -->\n<div class=\"p-6 bg-surface rounded-2xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group\">\n<div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-pine-deep mb-5 group-hover:bg-primary group-hover:text-on-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[24px]\">local_fire_department</span>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold\">Agni</span>\n<h3 class=\"text-title-lg font-title-lg text-primary mt-1 mb-3\">Fire</h3>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant leading-relaxed\">\n              Quiet room heaters, morning golden dawn rays piercing through the archways, and warm nourishing Himalayan broths.\n            </p>\n</div>\n<div class=\"pt-6 mt-4 border-t-0 flex items-center gap-2 text-label-sm font-label-sm uppercase tracking-wider text-outline group-hover:text-pine-deep\">\n<span>Radiant Warmth</span>\n<span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</div>\n</div>\n<!-- Element 4: Air -->\n<div class=\"p-6 bg-surface rounded-2xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group\">\n<div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-pine-deep mb-5 group-hover:bg-primary group-hover:text-on-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[24px]\">air</span>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold\">Vayu</span>\n<h3 class=\"text-title-lg font-title-lg text-primary mt-1 mb-3\">Air</h3>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant leading-relaxed\">\n              High-altitude, pure resinous pine breezes at 7,500 feet flowing softly through classic European arched verandas.\n            </p>\n</div>\n<div class=\"pt-6 mt-4 border-t-0 flex items-center gap-2 text-label-sm font-label-sm uppercase tracking-wider text-outline group-hover:text-pine-deep\">\n<span>Balcony Breezeways</span>\n<span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</div>\n</div>\n<!-- Element 5: Space / Ether -->\n<div class=\"p-6 bg-surface rounded-2xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group\">\n<div>\n<div class=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-pine-deep mb-5 group-hover:bg-primary group-hover:text-on-primary transition-colors\">\n<span class=\"material-symbols-outlined text-[24px]\">all_inclusive</span>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold\">Akasha</span>\n<h3 class=\"text-title-lg font-title-lg text-primary mt-1 mb-3\">Space / Ether</h3>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant leading-relaxed\">\n              Uncluttered minimalist interiors, spacious private sitting veranda, and clear starlit night skies above Doon Valley.\n            </p>\n</div>\n<div class=\"pt-6 mt-4 border-t-0 flex items-center gap-2 text-label-sm font-label-sm uppercase tracking-wider text-outline group-hover:text-pine-deep\">\n<span>Contemplative Void</span>\n<span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- All Spaces Include: Sanctuary Amenities Section -->\n<section class=\"w-full py-20 bg-surface\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12\">\n<div>\n<span class=\"text-label-md font-label-md uppercase tracking-[0.2em] text-pine-deep block mb-2\">Hospitality Inclusions</span>\n<h2 class=\"font-headline-lg text-headline-lg text-primary tracking-tight\">\n            All Spaces Include\n          </h2>\n</div>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant max-w-md\">\n          Thoughtfully appointed provisions ensuring complete comfort, restorative warmth, and seamless mountain relaxation throughout your stay.\n        </p>\n</div>\n<div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n<div class=\"p-6 bg-surface-container-low rounded-xl flex items-start gap-4 hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[28px] shrink-0\">menu_book</span>\n<div>\n<h4 class=\"text-title-md font-title-md text-primary mb-1\">Complimentary Readers Corner</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Unrestricted access to curated collections of Himalayan folklore, Ruskin Bond classics, poetry, and philosophy.</p>\n</div>\n</div>\n<div class=\"p-6 bg-surface-container-low rounded-xl flex items-start gap-4 hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[28px] shrink-0\">mode_heat</span>\n<div>\n<h4 class=\"text-title-md font-title-md text-primary mb-1\">Winter Amenities &amp; Kettle</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">In-room room heater, high-capacity electric kettle, handcrafted clay mugs, and regional herbal infusions.</p>\n</div>\n</div>\n<div class=\"p-6 bg-surface-container-low rounded-xl flex items-start gap-4 hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[28px] shrink-0\">restaurant</span>\n<div>\n<h4 class=\"text-title-md font-title-md text-primary mb-1\">Glass Box Restaurant</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Reserved panoramic dining overlooking the deodar valley, serving fresh farm-to-table organic Himalayan delicacies.</p>\n</div>\n</div>\n<div class=\"p-6 bg-surface-container-low rounded-xl flex items-start gap-4 hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[28px] shrink-0\">bed</span>\n<div>\n<h4 class=\"text-title-md font-title-md text-primary mb-1\">Family Extra Bed On Request</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Generous accommodation provisions for children or third travelers with bespoke organic cotton linens.</p>\n</div>\n</div>\n<div class=\"p-6 bg-surface-container-low rounded-xl flex items-start gap-4 hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[28px] shrink-0\">local_parking</span>\n<div>\n<h4 class=\"text-title-md font-title-md text-primary mb-1\">Complimentary Char Dukan Parking</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Guaranteed secure parking for your vehicle at Char Dukan ridge with personal porterage to the sanctuary.</p>\n</div>\n</div>\n<div class=\"p-6 bg-surface-container-low rounded-xl flex items-start gap-4 hover:bg-surface-container transition-colors\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[28px] shrink-0\">room_service</span>\n<div>\n<h4 class=\"text-title-md font-title-md text-primary mb-1\">Private Veranda F&amp;B Service</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Delight in afternoon chai, freshly baked ginger cookies, and artisan breakfast served directly on your terrace.</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Custom Stay Booking & Experience Request Form Section -->\n<section class=\"w-full py-20 bg-linen-subtle\" id=\"booking-inquiry\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"bg-surface rounded-2xl shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12\">\n<!-- Left Sanctuary Guarantee Column -->\n<div class=\"lg:col-span-5 bg-primary p-8 md:p-12 text-linen-base flex flex-col justify-between\">\n<div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold block mb-3\">\n              Direct Reservation Desk\n            </span>\n<h3 class=\"font-headline-lg text-headline-lg text-linen-base tracking-tight mb-4\">\n              Ready to Book Your Himalayan Alignment?\n            </h3>\n<p class=\"text-body-md font-body-md text-linen-base/80 leading-relaxed mb-8\">\n              Select your dates and preferred elemental orientation. Every reservation includes our signature breakfast at Glass Box Cafe and dedicated mountain concierge support.\n            </p>\n<div class=\"space-y-4\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">schedule</span>\n<span class=\"text-body-sm font-body-sm text-linen-base/90\">Check-in: 02:00 PM • Check-out: 11:00 AM</span>\n</div>\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">volume_off</span>\n<span class=\"text-body-sm font-body-sm text-linen-base/90\">Sanctuary Silence Hours: 10:00 PM onwards</span>\n</div>\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-cedar-gold text-[20px]\">support_agent</span>\n<span class=\"text-body-sm font-body-sm text-linen-base/90\">Call Concierge: +91-9068555303</span>\n</div>\n</div>\n</div>\n<div class=\"pt-8 mt-8 border-t-0 bg-pine-deep/50 p-4 rounded-xl\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-secondary-container block mb-1\">Elevation Guarantee</span>\n<p class=\"text-body-sm font-body-sm text-linen-base/70\">Unobstructed views of the Great Himalayan snow peaks or whispering Char Dukan deodars from every Element Room.</p>\n</div>\n</div>\n<!-- Right Inquiry Form Column -->\n<div class=\"lg:col-span-7 p-8 md:p-12 bg-surface\">\n<div class=\"mb-6\">\n<h4 class=\"text-headline-sm font-headline-sm text-primary\">Make Your Package &amp; Inquire</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Please fill the details below and our sanctuary curator will respond within 3 hours.</p>\n</div>\n<form data-demo-form=\"\" class=\"space-y-4\" id=\"cottage-booking-form\">\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n<div class=\"flex flex-col gap-1.5\">\n<label for=\"element-field-0\" class=\"text-label-sm font-label-sm uppercase tracking-wider text-on-surface\">Full Name <span class=\"text-cedar-gold\">*</span></label>\n<input aria-label=\"Full Name *\" name=\"element-field-0\" id=\"element-field-0\" class=\"w-full px-4 py-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:bg-surface text-body-md font-body-md\" placeholder=\"e.g. Arundhati Sharma\" required type=\"text\">\n</div>\n<div class=\"flex flex-col gap-1.5\">\n<label for=\"element-field-1\" class=\"text-label-sm font-label-sm uppercase tracking-wider text-on-surface\">Email Address <span class=\"text-cedar-gold\">*</span></label>\n<input aria-label=\"Email Address *\" name=\"element-field-1\" id=\"element-field-1\" class=\"w-full px-4 py-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:bg-surface text-body-md font-body-md\" placeholder=\"e.g. namaste@landour.com\" required type=\"email\">\n</div>\n</div>\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n<div class=\"flex flex-col gap-1.5\">\n<label for=\"element-field-2\" class=\"text-label-sm font-label-sm uppercase tracking-wider text-on-surface\">Phone Number <span class=\"text-cedar-gold\">*</span></label>\n<input aria-label=\"Phone Number *\" name=\"element-field-2\" id=\"element-field-2\" class=\"w-full px-4 py-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:bg-surface text-body-md font-body-md\" placeholder=\"+91 98765 43210\" required type=\"tel\">\n</div>\n<div class=\"flex flex-col gap-1.5\">\n<label for=\"element-field-3\" class=\"text-label-sm font-label-sm uppercase tracking-wider text-on-surface\">Length of Stay <span class=\"text-cedar-gold\">*</span></label>\n<select aria-label=\"Length of Stay *\" name=\"element-field-3\" id=\"element-field-3\" class=\"w-full px-4 py-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:bg-surface text-body-md font-body-md\">\n<option>Weekend Retreat (2 Nights)</option>\n<option>Mid-Week Deceleration (3 Nights)</option>\n<option>Elemental Alignment (5 Nights)</option>\n<option>Long Contemplative Sabbatical (7+ Nights)</option>\n</select>\n</div>\n</div>\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"text-label-sm font-label-sm uppercase tracking-wider text-on-surface\">Preferred Elemental Orientation</label>\n<div class=\"grid grid-cols-3 sm:grid-cols-5 gap-2\">\n<button aria-label=\"Prithvi\" class=\"element-chip px-3 py-2 bg-surface-container rounded-lg text-label-sm font-label-sm uppercase text-pine-deep hover:bg-pine-deep hover:text-on-primary transition-colors text-center\" type=\"button\">Prithvi</button>\n<button aria-label=\"Jal\" class=\"element-chip px-3 py-2 bg-surface-container rounded-lg text-label-sm font-label-sm uppercase text-pine-deep hover:bg-pine-deep hover:text-on-primary transition-colors text-center\" type=\"button\">Jal</button>\n<button aria-label=\"Agni\" class=\"element-chip px-3 py-2 bg-surface-container rounded-lg text-label-sm font-label-sm uppercase text-pine-deep hover:bg-pine-deep hover:text-on-primary transition-colors text-center\" type=\"button\">Agni</button>\n<button aria-label=\"Vayu\" class=\"element-chip px-3 py-2 bg-surface-container rounded-lg text-label-sm font-label-sm uppercase text-pine-deep hover:bg-pine-deep hover:text-on-primary transition-colors text-center\" type=\"button\">Vayu</button>\n<button aria-label=\"Akasha\" class=\"element-chip px-3 py-2 bg-surface-container rounded-lg text-label-sm font-label-sm uppercase text-pine-deep hover:bg-pine-deep hover:text-on-primary transition-colors text-center\" type=\"button\">Akasha</button>\n</div>\n</div>\n<div class=\"flex flex-col gap-1.5\">\n<label for=\"element-field-4\" class=\"text-label-sm font-label-sm uppercase tracking-wider text-on-surface\">Paint a Picture of What You Want to Explore</label>\n<textarea aria-label=\"Paint a Picture of What You Want to Explore\" name=\"element-field-4\" id=\"element-field-4\" class=\"w-full px-4 py-3 bg-surface-container-low text-on-surface rounded-lg focus:outline-none focus:bg-surface text-body-md font-body-md\" placeholder=\"Tell us if you desire silence, guided forest walks, writer's desk setup, or specific dietary preferences...\" rows=\"3\"></textarea>\n</div>\n<div class=\"pt-2\">\n<button aria-label=\"Get A Personalized Plan east\" class=\"w-full py-3.5 bg-pine-deep hover:bg-pine-muted text-linen-base font-label-md text-label-md uppercase tracking-widest rounded-lg shadow-md transition-all flex items-center justify-center gap-2\" type=\"submit\">\n<span>Get A Personalized Plan</span>\n<span class=\"material-symbols-outlined text-[16px]\">east</span>\n</button>\n</div>\n<div class=\"hidden p-4 bg-primary/10 text-pine-deep rounded-lg text-body-sm font-body-sm flex items-center gap-2 mt-3\" id=\"booking-success\">\n<span class=\"material-symbols-outlined text-[20px] text-emerald-700\">check_circle</span>\n<span>Thank you. Your elemental stay inquiry has been submitted. Our concierge will be in touch shortly.</span>\n</div>\n<p class=\"demo-note\">Demo inquiry only. No message or reservation will be sent.</p></form>\n</div>\n</div>\n</div>\n</section>\n<!-- Historic Char Dukan & Walking Heritage Context -->\n<section class=\"w-full py-20 bg-surface\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"mb-12\">\n<span class=\"text-label-md font-label-md uppercase tracking-[0.2em] text-cedar-gold block mb-2\">Heritage Ridge</span>\n<h2 class=\"font-headline-lg text-headline-lg text-primary tracking-tight\">\n          Surroundings &amp; Walking Itinerary\n        </h2>\n<p class=\"text-body-md font-body-md text-on-surface-variant max-w-2xl mt-2\">\n          Step right from your European Courtyard Cottage into the historic Upper Mall circuit of Landour cantonment.\n        </p>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n<div class=\"p-6 bg-surface-container-low rounded-xl flex flex-col justify-between\">\n<div>\n<span class=\"text-title-lg font-title-lg text-pine-deep\">0.1 KM</span>\n<h4 class=\"text-title-md font-title-md text-primary mt-1 mb-2\">St. Paul's Church</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Erected in 1839 amidst towering deodars. Historic cantonment architecture with stained glass windows.</p>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-outline mt-6 block\">Adjacent (2 Min Walk)</span>\n</div>\n<div class=\"p-6 bg-surface-container-low rounded-xl flex flex-col justify-between\">\n<div>\n<span class=\"text-title-lg font-title-lg text-pine-deep\">0.8 KM</span>\n<h4 class=\"text-title-md font-title-md text-primary mt-1 mb-2\">Lal Tibba Viewpoint</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Highest peak in Landour offering telescope views of Badrinath, Kedarnath, and the Chaukhamba massifs.</p>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-outline mt-6 block\">12 Min Ridge Walk</span>\n</div>\n<div class=\"p-6 bg-surface-container-low rounded-xl flex flex-col justify-between\">\n<div>\n<span class=\"text-title-lg font-title-lg text-pine-deep\">1.2 KM</span>\n<h4 class=\"text-title-md font-title-md text-primary mt-1 mb-2\">Sister's Bazaar &amp; Prakash</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Home of homemade peanut butter, cheddar cheese, and artisanal preserves crafted in Landour since the 1920s.</p>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-outline mt-6 block\">18 Min Forest Stroll</span>\n</div>\n<div class=\"p-6 bg-surface-container-low rounded-xl flex flex-col justify-between\">\n<div>\n<span class=\"text-title-lg font-title-lg text-pine-deep\">64 KM</span>\n<h4 class=\"text-title-md font-title-md text-primary mt-1 mb-2\">Jolly Grant Airport (DED)</h4>\n<p class=\"text-body-sm font-body-sm text-on-surface-variant\">Seamless private mountain transfer through scenic winding roads ascending directly to Char Dukan.</p>\n</div>\n<span class=\"text-label-sm font-label-sm uppercase tracking-wider text-outline mt-6 block\">2 Hours Mountain Drive</span>\n</div>\n</div>\n<!-- Static Map Elevation Banner -->\n<div class=\"mt-8 rounded-2xl overflow-hidden shadow-sm\">\n<div class=\"w-full h-72 bg-cover bg-center flex items-end p-6\" data-location=\"Char Dukan, Landour, Mussoorie, Uttarakhand\" style=\"background-image: url('/assets/7d437da87451dbd1.webp')\">\n<div class=\"bg-surface/95 backdrop-blur-md p-4 rounded-xl shadow-md max-w-md\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold block mb-1\">Mountain Sanctuary Co-ordinates</span>\n<p class=\"text-body-sm font-body-sm text-on-surface font-medium\">30.4598° N, 78.0934° E • Elevation 7,500 Feet Above Sea Level</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n</div>\n</main>",
