{
  "slug": "about",
  "title": "About Our Himalayan Sanctuary",
  "html": "<main id=\"main-content\" class=\"w-full pt-28 bg-surface\"><div class=\"flex flex-col w-full\">\n<!-- Atmospheric Hero Section Bleeding Under Translucent Header -->\n<section class=\"relative w-full -mt-28 min-h-[92vh] flex items-end pb-20 overflow-hidden\">\n<!-- Alpine Background with Scrim -->\n<div class=\"absolute inset-0 z-0 scale-105 transition-transform duration-1000 ease-out\" data-alt=\"Majestic panoramic view of the Garhwal Himalayas from a historic wooden balcony in Landour Mussoorie at sunrise, snow-capped mountain peaks rising above dense morning mist and deodar pine forests, golden sunlight warming traditional slate architecture, peaceful and luxurious mountain sanctuary atmosphere with alpine serenity.\" id=\"hero-bg\" style=\"background-image: url('/assets/39c450a626f0abcb.webp')\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-primary via-primary/50 to-primary/20\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-r from-primary/80 via-transparent to-transparent\"></div>\n</div>\n<!-- Hero Content Container -->\n<div class=\"relative z-10 w-full max-w-[1320px] mx-auto px-6 pt-36\">\n<div class=\"max-w-3xl flex flex-col gap-6\">\n<!-- Floating Pill Indicator -->\n<div class=\"inline-flex items-center gap-3 px-4 py-2 rounded-full bg-surface-bright/15 backdrop-blur-md w-fit shadow-md\">\n<span class=\"w-2 h-2 rounded-full bg-amber-gold-bright animate-ping\"></span>\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-surface-bright\">About Us • The Sanctuary Story</span>\n<span class=\"text-mist-silver text-label-sm\">|</span>\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-cedar-gold\">Elevation 7,500 FT • Upper Mall, Landour</span>\n</div>\n<!-- Staggered Revealing Headline -->\n<div class=\"flex flex-col gap-2\">\n<h1 class=\"font-display text-display text-surface-bright leading-[1.08] tracking-tight\">\n            A Beacon of Shining Light in the <span class=\"italic text-secondary-fixed\">Heart of Landour</span>\n</h1>\n<p class=\"font-body-lg text-body-lg text-surface-bright/85 max-w-2xl mt-4 leading-relaxed\">\n            Designed to awaken your senses and bring to you the joys of pure nature harmony, contemplative deceleration, and holistic well-being amidst pristine Himalayan heights.\n          </p>\n</div>\n<!-- Quick Interaction Bar -->\n<div class=\"flex flex-wrap items-center gap-4 pt-4\">\n<a class=\"inline-flex items-center gap-2 px-7 py-3.5 bg-secondary-container text-on-secondary-fixed font-label-md text-label-md uppercase tracking-wider rounded-lg shadow-xl hover:bg-cedar-gold hover:text-surface-bright transition-all group\" href=\"#sanctuary-story\">\n<span>Discover The Journey</span>\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[18px] group-hover:translate-y-0.5 transition-transform\">arrow_downward</span>\n</a>\n<button aria-label=\"auto_awesome Make Your Package\" class=\"inline-flex items-center gap-2 px-7 py-3.5 bg-surface-bright/10 hover:bg-surface-bright/20 backdrop-blur-md text-surface-bright font-label-md text-label-md uppercase tracking-wider rounded-lg shadow-md transition-all\" id=\"open-itinerary-btn\" type=\"button\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[18px] text-cedar-gold\">auto_awesome</span>\n<span>Make Your Package</span>\n</button>\n</div>\n</div>\n</div>\n</section>\n<!-- Sanctuary Quick Metrics / Floating Micro-Grid -->\n<section class=\"relative z-20 -mt-10 max-w-[1320px] mx-auto px-6 w-full\">\n<div class=\"grid grid-cols-1 md:grid-cols-4 gap-4 bg-linen-base/95 backdrop-blur-xl p-6 rounded-xl shadow-xl\">\n<div class=\"flex items-center gap-4 p-3 bg-linen-subtle/80 rounded-lg\">\n<div class=\"w-12 h-12 rounded-lg bg-pine-deep/10 flex items-center justify-center text-pine-deep\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[24px]\">mountain_flag</span>\n</div>\n<div>\n<span class=\"font-headline-sm text-headline-sm text-pine-deep block leading-tight\">7,500 FT</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Himalayan Altitude</span>\n</div>\n</div>\n<div class=\"flex items-center gap-4 p-3 bg-linen-subtle/80 rounded-lg\">\n<div class=\"w-12 h-12 rounded-lg bg-cedar-gold/15 flex items-center justify-center text-cedar-gold\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[24px]\">self_improvement</span>\n</div>\n<div>\n<span class=\"font-headline-sm text-headline-sm text-pine-deep block leading-tight\">Sanatana Dharma</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Spiritual Blueprint</span>\n</div>\n</div>\n<div class=\"flex items-center gap-4 p-3 bg-linen-subtle/80 rounded-lg\">\n<div class=\"w-12 h-12 rounded-lg bg-pine-deep/10 flex items-center justify-center text-pine-deep\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[24px]\">spa</span>\n</div>\n<div>\n<span class=\"font-headline-sm text-headline-sm text-pine-deep block leading-tight\">Mudras &amp; Chakras</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Triad Suite Themes</span>\n</div>\n</div>\n<div class=\"flex items-center gap-4 p-3 bg-linen-subtle/80 rounded-lg\">\n<div class=\"w-12 h-12 rounded-lg bg-cedar-gold/15 flex items-center justify-center text-cedar-gold\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[24px]\">nature_people</span>\n</div>\n<div>\n<span class=\"font-headline-sm text-headline-sm text-pine-deep block leading-tight\">0 Forest Spoil</span>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant uppercase\">Biophilic Sanctuary</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Genesis & Philosophy Section (\"The Sanctuary Story\") -->\n<section class=\"py-24 max-w-[1320px] mx-auto px-6 w-full\" id=\"sanctuary-story\">\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n<!-- Left Editorial Narrative -->\n<div class=\"lg:col-span-6 flex flex-col gap-6\">\n<div class=\"flex items-center gap-2\">\n<span class=\"w-8 h-[1px] bg-cedar-gold\"></span>\n<span class=\"font-label-md text-label-md uppercase tracking-widest text-cedar-gold\">Our Genesis &amp; Mountain Roots</span>\n</div>\n<h2 class=\"font-headline-lg text-headline-lg text-pine-deep leading-tight\">\n          Awakening Through <span class=\"italic text-cedar-gold\">Sacred Wisdom</span> &amp; Primordial Pines\n        </h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n          Discover an intimate boutique sanctuary nestled in the serene embrace of the captivating Landour ridge, just above Mussoorie. Immersed in the positive currents that drape the Garhwal peaks, Light of Landour was envisioned as a tranquil haven where modern souls can indulge in a restorative pause.\n        </p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n          We draw boundless energy from the ancient traditions of Sanatana Dharma and Yogic science. Each suite, courtyard, and timber veranda is deliberately shaped to harmonize the physical body with cosmic vibrations, inviting guests to release mental static and welcome stillness.\n        </p>\n<!-- The Philosophical Pillars Grid -->\n<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4\">\n<div class=\"p-4 bg-linen-subtle rounded-lg shadow-sm hover:shadow-md transition-all\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[24px] text-cedar-gold mb-2 block\">flare</span>\n<span class=\"font-title-md text-title-md text-pine-deep block leading-tight mb-1\">Cosmic Energy</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Attuning biological clocks to deodar mountain dawns and clean Himalayan winds.</p>\n</div>\n<div class=\"p-4 bg-linen-subtle rounded-lg shadow-sm hover:shadow-md transition-all\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[24px] text-cedar-gold mb-2 block\">all_inclusive</span>\n<span class=\"font-title-md text-title-md text-pine-deep block leading-tight mb-1\">Triad of Being</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Consciously balancing Heart (Mudras), Soul (Chakras), and Body (Elements).</p>\n</div>\n<div class=\"p-4 bg-linen-subtle rounded-lg shadow-sm hover:shadow-md transition-all\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[24px] text-cedar-gold mb-2 block\">church</span>\n<span class=\"font-title-md text-title-md text-pine-deep block leading-tight mb-1\">Living Heritage</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Preserving the colonial mystique of Char Dukan and historic St. Paul's Church.</p>\n</div>\n</div>\n</div>\n<!-- Right Visual Asymmetric Collage -->\n<div class=\"lg:col-span-6 relative\">\n<div class=\"grid grid-cols-12 gap-4 items-center\">\n<div class=\"col-span-8 rounded-xl overflow-hidden shadow-2xl relative group\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/0e5df2a47fc08f65-480.webp 480w, /assets/0e5df2a47fc08f65.webp 700w\" height=\"450\" width=\"700\" fetchpriority=\"high\" decoding=\"async\" loading=\"eager\" alt=\"Guests enjoying morning Himalayan chai on the heritage stone balcony at Light of Landour\" class=\"w-full h-[420px] object-cover transition-transform duration-700 group-hover:scale-105\" src=\"/assets/0e5df2a47fc08f65.webp\">\n<div class=\"absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-pine-deep/80 to-transparent text-surface-bright\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider block\">Veranda of Contemplation</span>\n<span class=\"font-headline-sm text-headline-sm\">Tea Overlooking the Mist</span>\n</div>\n</div>\n<div class=\"col-span-4 flex flex-col gap-4\">\n<div class=\"rounded-xl overflow-hidden shadow-xl group\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/44ccfb4284832c09-480.webp 480w, /assets/44ccfb4284832c09.webp 500w\" height=\"500\" width=\"500\" decoding=\"async\" loading=\"lazy\" alt=\"Light of Landour retreat nestled deep inside the ancient deodar canopy\" class=\"w-full h-52 object-cover transition-transform duration-700 group-hover:scale-105\" src=\"/assets/44ccfb4284832c09.webp\">\n</div>\n<div class=\"p-5 bg-primary-container text-on-primary rounded-xl shadow-lg flex flex-col gap-2\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-secondary-fixed text-[26px]\">wb_twilight</span>\n<span class=\"font-title-md text-title-md\">The Landour Twilight</span>\n<p class=\"font-body-sm text-body-sm text-on-primary-container\">Witness the rare winter line and sunset glow illuminating the Doon valley below.</p>\n</div>\n</div>\n</div>\n<!-- Decorative Floating Seal -->\n<div class=\"absolute -bottom-6 -left-6 hidden sm:flex items-center gap-3 p-4 bg-linen-base rounded-xl shadow-xl\">\n<div class=\"w-10 h-10 rounded-full bg-cedar-gold/20 flex items-center justify-center text-cedar-gold\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[20px]\">verified</span>\n</div>\n<div>\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant block\">Established</span>\n<span class=\"font-title-md text-title-md text-pine-deep\">A Sanctuary of Deceleration</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- The Three Pillars of Experience (Interactive Cards) -->\n<section class=\"py-20 bg-linen-subtle w-full\">\n<div class=\"max-w-[1320px] mx-auto px-6 flex flex-col gap-12\">\n<div class=\"flex flex-col md:flex-row md:items-end justify-between gap-6\">\n<div class=\"max-w-2xl flex flex-col gap-3\">\n<div class=\"flex items-center gap-2\">\n<span class=\"w-8 h-[1px] bg-cedar-gold\"></span>\n<span class=\"font-label-md text-label-md uppercase tracking-widest text-cedar-gold\">The Triad of Being</span>\n</div>\n<h2 class=\"font-headline-lg text-headline-lg text-pine-deep\">\n            Three Distinct Expressions of Rest &amp; Resonance\n          </h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n            Each living space within our sanctuary is curated to resonate with a specific facet of human consciousness.\n          </p>\n</div>\n<div class=\"flex items-center gap-3\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant\">Explore Suites</span>\n<a data-demo-info=\"arrow_forward\" class=\"w-10 h-10 rounded-full bg-linen-base shadow-sm flex items-center justify-center text-pine-deep hover:bg-pine-deep hover:text-surface-bright transition-colors\" href=\"#inquiry\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</a>\n</div>\n</div>\n<!-- Interactive Pillars Grid -->\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n<!-- Pillar 1: Mudras (Heart) -->\n<div class=\"group flex flex-col bg-linen-base rounded-xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-1.5\">\n<div class=\"relative h-64 w-full overflow-hidden\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/88bdd75ee9356ba9-480.webp 480w, /assets/88bdd75ee9356ba9.webp 700w\" height=\"700\" width=\"700\" decoding=\"async\" loading=\"lazy\" alt=\"Sophisticated interior of Mudra Rooms with soft wood tones and artisanal textures\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" src=\"/assets/88bdd75ee9356ba9.webp\">\n<div class=\"absolute top-4 left-4 px-3 py-1 bg-surface-bright/90 backdrop-blur-md rounded-full shadow-sm\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-pine-deep\">Pillar I • Anahata</span>\n</div>\n</div>\n<div class=\"p-6 flex flex-col justify-between flex-1 gap-6\">\n<div class=\"flex flex-col gap-3\">\n<span class=\"text-label-md font-label-md uppercase tracking-wider text-cedar-gold\">Inspired By Mudras</span>\n<h3 class=\"font-headline-md text-headline-md text-pine-deep leading-snug\">The Heart Expression</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n                An experience for you to grow, evolve, and discover the magic of life. Mellow-toned spaces adorned with sophisticated interiors, handcrafted cedar accents, and private balconies offering sweeping valley panoramas.\n              </p>\n</div>\n<div class=\"pt-4 flex items-center justify-between\">\n<div class=\"flex items-center gap-3 text-body-sm font-body-sm text-on-surface-variant\">\n<span class=\"flex items-center gap-1\"><span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] text-cedar-gold\">balcony</span>Balcony</span>\n<span>•</span>\n<span class=\"flex items-center gap-1\"><span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] text-cedar-gold\">bed</span>King Bed</span>\n</div>\n<a data-demo-info=\"View\neast\" class=\"font-label-md text-label-md uppercase tracking-wider text-pine-deep group-hover:text-cedar-gold flex items-center gap-1 transition-colors\" href=\"#inquiry\">\n<span>View</span>\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px]\">east</span>\n</a>\n</div>\n</div>\n</div>\n<!-- Pillar 2: Chakras (Soul) -->\n<div class=\"group flex flex-col bg-linen-base rounded-xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-1.5\">\n<div class=\"relative h-64 w-full overflow-hidden\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/1f41f6d2a61e11fa-480.webp 480w, /assets/1f41f6d2a61e11fa-960.webp 960w, /assets/1f41f6d2a61e11fa.webp 1200w\" height=\"896\" width=\"1200\" decoding=\"async\" loading=\"lazy\" alt=\"Chakra inspired mountain room interior with panoramic mountain views and floor-to-ceiling glass\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" src=\"/assets/1f41f6d2a61e11fa.webp\">\n<div class=\"absolute top-4 left-4 px-3 py-1 bg-surface-bright/90 backdrop-blur-md rounded-full shadow-sm\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-pine-deep\">Pillar II • Sahasrara</span>\n</div>\n</div>\n<div class=\"p-6 flex flex-col justify-between flex-1 gap-6\">\n<div class=\"flex flex-col gap-3\">\n<span class=\"text-label-md font-label-md uppercase tracking-wider text-cedar-gold\">Inspired By Chakras</span>\n<h3 class=\"font-headline-md text-headline-md text-pine-deep leading-snug\">The Soul Expression</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n                Creating an atmosphere of sublime harmony and balance within the self. Oriented directly toward the eternal snow-laden crests of the Garhwal range to induce deep states of contemplative calm and reflection.\n              </p>\n</div>\n<div class=\"pt-4 flex items-center justify-between\">\n<div class=\"flex items-center gap-3 text-body-sm font-body-sm text-on-surface-variant\">\n<span class=\"flex items-center gap-1\"><span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] text-cedar-gold\">visibility</span>Valley View</span>\n<span>•</span>\n<span class=\"flex items-center gap-1\"><span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] text-cedar-gold\">bathtub</span>Herbal Bath</span>\n</div>\n<a data-demo-info=\"View\neast\" class=\"font-label-md text-label-md uppercase tracking-wider text-pine-deep group-hover:text-cedar-gold flex items-center gap-1 transition-colors\" href=\"#inquiry\">\n<span>View</span>\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px]\">east</span>\n</a>\n</div>\n</div>\n</div>\n<!-- Pillar 3: Elements (Body) -->\n<div class=\"group flex flex-col bg-linen-base rounded-xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-1.5\">\n<div class=\"relative h-64 w-full overflow-hidden\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/2615f5a1630d1794-480.webp 480w, /assets/2615f5a1630d1794-960.webp 960w, /assets/2615f5a1630d1794.webp 1024w\" height=\"768\" width=\"1024\" decoding=\"async\" loading=\"lazy\" alt=\"Element rooms featuring raw stone finishes, warm woods, and serene biophilic design\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" src=\"/assets/2615f5a1630d1794.webp\">\n<div class=\"absolute top-4 left-4 px-3 py-1 bg-surface-bright/90 backdrop-blur-md rounded-full shadow-sm\">\n<span class=\"text-label-sm font-label-sm uppercase tracking-widest text-pine-deep\">Pillar III • Pancha Mahabhuta</span>\n</div>\n</div>\n<div class=\"p-6 flex flex-col justify-between flex-1 gap-6\">\n<div class=\"flex flex-col gap-3\">\n<span class=\"text-label-md font-label-md uppercase tracking-wider text-cedar-gold\">Inspired By Elements</span>\n<h3 class=\"font-headline-md text-headline-md text-pine-deep leading-snug\">The Body Expression</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n                Immerse yourself in a grounded wellbeing journey crafted with biophilic slate masonry, unvarnished deodar timber, tactile linen weaves, and natural filtered mountain daylight that nurtures restorative sleep.\n              </p>\n</div>\n<div class=\"pt-4 flex items-center justify-between\">\n<div class=\"flex items-center gap-3 text-body-sm font-body-sm text-on-surface-variant\">\n<span class=\"flex items-center gap-1\"><span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] text-cedar-gold\">forest</span>Forest Rim</span>\n<span>•</span>\n<span class=\"flex items-center gap-1\"><span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] text-cedar-gold\">fireplace</span>Warmth</span>\n</div>\n<a data-demo-info=\"View\neast\" class=\"font-label-md text-label-md uppercase tracking-wider text-pine-deep group-hover:text-cedar-gold flex items-center gap-1 transition-colors\" href=\"#inquiry\">\n<span>View</span>\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px]\">east</span>\n</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Core Manifesto Banner / Deep Pine Block -->\n<section class=\"relative py-24 bg-primary-container text-on-primary w-full overflow-hidden\">\n<!-- Subtle Ambient Mountain Lines (Inline SVG Graphic) -->\n<div class=\"absolute inset-0 opacity-10 pointer-events-none flex items-center justify-center\">\n<svg class=\"w-full h-full\" fill=\"none\" preserveAspectRatio=\"none\" viewBox=\"0 0 1440 600\">\n<path d=\"M0 450L320 280L640 380L960 180L1280 340L1440 240V600H0V450Z\" fill=\"currentColor\" />\n<path d=\"M0 500L240 390L580 430L820 310L1120 400L1440 330V600H0V500Z\" fill=\"currentColor\" />\n</svg>\n</div>\n<div class=\"relative z-10 max-w-[1040px] mx-auto px-6 text-center flex flex-col items-center gap-8\">\n<div class=\"inline-flex items-center justify-center p-3 rounded-full bg-surface-bright/10 text-cedar-gold mb-2\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[32px]\">self_improvement</span>\n</div>\n<span class=\"font-label-md text-label-md uppercase tracking-[0.24em] text-secondary-fixed\">Sanctuary Manifesto</span>\n<h2 class=\"font-headline-lg text-headline-lg text-surface-bright max-w-3xl leading-snug\">\n        “Wisdom Speaks — Let’s Break The Cycle”\n      </h2>\n<p class=\"font-body-lg text-body-lg text-on-primary-container max-w-2xl leading-relaxed italic\">\n        When you decide to take a break from the old patterns, you are not only transforming yourself but bringing a halt to the perpetual cycle of unconscious and trauma. When you lift your vibrations, you are lifting the vibrations of the planet.\n      </p>\n<div class=\"w-16 h-[1px] bg-cedar-gold\"></div>\n<div class=\"flex flex-col gap-2\">\n<p class=\"font-title-lg text-title-lg text-secondary-fixed tracking-wide\">\n          Give yourself away in Love &amp; Knowledge to attain soulful balance from head to heart.\n        </p>\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-mist-silver\">The Guiding Principle of Light of Landour</span>\n</div>\n</div>\n</section>\n<!-- Built On Sustainability & Biophilic Architecture Section -->\n<section class=\"py-24 max-w-[1320px] mx-auto px-6 w-full\">\n<div class=\"flex flex-col gap-16\">\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n<!-- Narrative Column -->\n<div class=\"lg:col-span-6 flex flex-col gap-6\">\n<div class=\"flex items-center gap-2\">\n<span class=\"w-8 h-[1px] bg-cedar-gold\"></span>\n<span class=\"font-label-md text-label-md uppercase tracking-widest text-cedar-gold\">Ecological Stewardship</span>\n</div>\n<h2 class=\"font-headline-lg text-headline-lg text-pine-deep leading-tight\">\n            Built On Sustainability • In Deep Reverence to the Forest\n          </h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n            Embracing the ethos of conscious sustainability, our resort is carefully crafted to intertwine with lush greenery, fostering a design philosophy that promotes wellness and environmental harmony. We prioritize preserving the natural landscape, allowing ancient deodars to thrive unhindered, and enveloping our structures in a gentle embrace.\n          </p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n            Native flora and biophilic design principles create an aesthetically grounding environment while enhancing the human connection with the natural world—reducing cortisol, heightening sensory perception, and nurturing long-term vitality.\n          </p>\n<!-- Commitment Highlights -->\n<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4\">\n<div class=\"flex flex-col gap-1 p-4 bg-linen-subtle rounded-lg\">\n<span class=\"font-headline-md text-headline-md text-pine-deep\">0</span>\n<span class=\"font-title-md text-title-md text-pine-deep\">Forest Spoil</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Built sensitively around century-old deodar tree roots.</p>\n</div>\n<div class=\"flex flex-col gap-1 p-4 bg-linen-subtle rounded-lg\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[24px] text-cedar-gold mb-1\">domain</span>\n<span class=\"font-title-md text-title-md text-pine-deep\">Biophilic Slate</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Hand-chiseled Garhwal stone, untreated cedar, and daylighting.</p>\n</div>\n<div class=\"flex flex-col gap-1 p-4 bg-linen-subtle rounded-lg\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[24px] text-cedar-gold mb-1\">handyman</span>\n<span class=\"font-title-md text-title-md text-pine-deep\">Hill Artisans</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Honoring local masonry traditions and regional hill ingredients.</p>\n</div>\n</div>\n</div>\n<!-- Masonry Photo Grid -->\n<div class=\"lg:col-span-6 grid grid-cols-12 gap-4\">\n<div class=\"col-span-7 flex flex-col gap-4\">\n<div class=\"rounded-xl overflow-hidden shadow-xl group\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/9099feb8b042e185-480.webp 480w, /assets/9099feb8b042e185.webp 700w\" height=\"700\" width=\"700\" decoding=\"async\" loading=\"lazy\" alt=\"Morning warm drink looking out at the forested ridges of Landour\" class=\"w-full h-72 object-cover transition-transform duration-700 group-hover:scale-105\" src=\"/assets/9099feb8b042e185.webp\">\n</div>\n<div class=\"rounded-xl overflow-hidden shadow-xl group\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/6f2aae61619f950e-480.webp 480w, /assets/6f2aae61619f950e.webp 520w\" height=\"600\" width=\"520\" decoding=\"async\" loading=\"lazy\" alt=\"Cosy attic room suite at Light of Landour resort\" class=\"w-full h-56 object-cover transition-transform duration-700 group-hover:scale-105\" src=\"/assets/6f2aae61619f950e.webp\">\n</div>\n</div>\n<div class=\"col-span-5\">\n<div class=\"rounded-xl overflow-hidden shadow-2xl h-full group\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/752939867067624d-480.webp 480w, /assets/752939867067624d.webp 683w\" height=\"1024\" width=\"683\" decoding=\"async\" loading=\"lazy\" alt=\"Stone crafted ensuite attic retreat overlooking misty pine forests\" class=\"w-full h-full min-h-[500px] object-cover transition-transform duration-700 group-hover:scale-105\" src=\"/assets/752939867067624d.webp\">\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Location Landmark & Alpine Reach -->\n<section class=\"py-20 bg-linen-subtle w-full\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n<!-- Interactive Map / Location Block -->\n<div class=\"lg:col-span-6 flex flex-col gap-4\">\n<div class=\"w-full h-96 rounded-xl bg-cover bg-center shadow-lg relative overflow-hidden group\" data-alt=\"Satellite and scenic topographic map showing Landour Cantt, Char Dukan, Upper Mall road, and pine-clad hills of Mussoorie Uttarakhand with mountain elevation contours.\" data-location=\"Char Dukan, Landour, Mussoorie, Uttarakhand\" style=\"background-image: url('/assets/93320c4cd46926c9.webp')\">\n<div class=\"absolute inset-0 bg-pine-deep/40 transition-opacity group-hover:bg-pine-deep/20\"></div>\n<div class=\"absolute top-4 left-4 p-3 bg-linen-base/95 backdrop-blur-md rounded-lg shadow-md max-w-xs\">\n<span class=\"font-title-md text-title-md text-pine-deep block\">Light of Landour</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1 mt-1\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[14px] text-cedar-gold\">location_on</span>\n                Upper Mall, Char Dukan Ridge, 7500 FT\n              </span>\n</div>\n<div class=\"absolute bottom-4 right-4\">\n<a class=\"px-3 py-1.5 bg-pine-deep text-linen-base font-label-sm text-label-sm uppercase tracking-wider rounded-lg shadow-md hover:bg-pine-muted transition-colors inline-flex items-center gap-1\" href=\"https://www.google.com/maps/search/?api=1&query=Light+of+Landour+Char+Dukan+Mussoorie\" rel=\"noopener noreferrer\" target=\"_blank\">\n<span>View in Google Maps</span>\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[14px]\">launch</span>\n</a>\n</div>\n</div>\n</div>\n<!-- Neighborhood Context & Proximity -->\n<div class=\"lg:col-span-6 flex flex-col gap-6\">\n<div class=\"flex items-center gap-2\">\n<span class=\"w-8 h-[1px] bg-cedar-gold\"></span>\n<span class=\"font-label-md text-label-md uppercase tracking-widest text-cedar-gold\">The Enchanted Ridge</span>\n</div>\n<h2 class=\"font-headline-lg text-headline-lg text-pine-deep\">\n            Moments from Historic Char Dukan &amp; St. Paul’s\n          </h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n            Landour has long stood as a quiet sanctuary for writers, botanists, and seekers. Perched along the historic Upper Mall, our retreat grants effortless walking access to the timeless icons of the ridge.\n          </p>\n<div class=\"flex flex-col gap-3\">\n<div class=\"flex items-center justify-between p-3.5 bg-linen-base rounded-lg shadow-sm\">\n<div class=\"flex items-center gap-3\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-cedar-gold\">bakery_dining</span>\n<span class=\"font-title-md text-title-md text-pine-deep\">Char Dukan &amp; Anil's Cafe</span>\n</div>\n<span class=\"font-label-sm text-label-sm uppercase text-on-surface-variant\">3 Mins Walk</span>\n</div>\n<div class=\"flex items-center justify-between p-3.5 bg-linen-base rounded-lg shadow-sm\">\n<div class=\"flex items-center gap-3\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-cedar-gold\">church</span>\n<span class=\"font-title-md text-title-md text-pine-deep\">Historic St. Paul’s Church (1839)</span>\n</div>\n<span class=\"font-label-sm text-label-sm uppercase text-on-surface-variant\">4 Mins Walk</span>\n</div>\n<div class=\"flex items-center justify-between p-3.5 bg-linen-base rounded-lg shadow-sm\">\n<div class=\"flex items-center gap-3\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-cedar-gold\">storefront</span>\n<span class=\"font-title-md text-title-md text-pine-deep\">Sister’s Bazaar &amp; Prakash Stores</span>\n</div>\n<span class=\"font-label-sm text-label-sm uppercase text-on-surface-variant\">10 Mins Walk</span>\n</div>\n<div class=\"flex items-center justify-between p-3.5 bg-linen-base rounded-lg shadow-sm\">\n<div class=\"flex items-center gap-3\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-cedar-gold\">landscape</span>\n<span class=\"font-title-md text-title-md text-pine-deep\">Lal Tibba Scenic Viewpoint</span>\n</div>\n<span class=\"font-label-sm text-label-sm uppercase text-on-surface-variant\">15 Mins Walk</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Reservation CTA Banner -->\n<section class=\"py-20 max-w-[1320px] mx-auto px-6 w-full\">\n<div class=\"p-10 md:p-14 bg-pine-deep text-linen-base rounded-2xl shadow-2xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8\">\n<!-- Decorative Backdrop Glow -->\n<div class=\"absolute -right-24 -bottom-24 w-96 h-96 rounded-full bg-cedar-gold/10 blur-3xl pointer-events-none\"></div>\n<div class=\"flex flex-col gap-3 max-w-xl\">\n<span class=\"font-label-md text-label-md uppercase tracking-widest text-secondary-fixed\">Awaken Your Senses</span>\n<h2 class=\"font-headline-lg text-headline-lg text-surface-bright\">Experience the Light of Landour</h2>\n<p class=\"font-body-md text-body-md text-on-primary-container leading-relaxed\">\n          Surrender to the serene cadence of the Garhwal mountains. Reserve your bespoke suite or consult our mountain hosts for tailored wellness journeys.\n        </p>\n</div>\n<div class=\"flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto\">\n<a class=\"w-full sm:w-auto px-8 py-4 bg-secondary-container text-on-secondary-fixed font-label-md text-label-md uppercase tracking-wider rounded-lg shadow-lg hover:bg-cedar-gold hover:text-surface-bright transition-all text-center\" data-path=\"accommodation\" href=\"/#accommodation\">\n          Explore Accommodations\n        </a>\n<button aria-label=\"Plan Bespoke Stay\" class=\"w-full sm:w-auto px-8 py-4 bg-surface-bright/10 hover:bg-surface-bright/20 backdrop-blur-md text-surface-bright font-label-md text-label-md uppercase tracking-wider rounded-lg shadow-md transition-all text-center\" id=\"open-itinerary-btn-2\" type=\"button\">\n          Plan Bespoke Stay\n        </button>\n</div>\n</div>\n</section>\n<!-- Bespoke Itinerary & \"Make Your Package\" Modal -->\n\n<!-- Interactive Scripts for Micro-Interactions -->\n\n</div></main>",
