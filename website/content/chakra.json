  "title": "Chakra Rooms & Suites",
  "html": "<main id=\"main-content\" class=\"w-full pt-28 bg-surface\"><div class=\"flex flex-col w-full\">\n<!-- SECTION 1: HERO & SANCTUARY ELEVATION -->\n<section class=\"relative w-full overflow-hidden bg-linen-base py-12 lg:py-20\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<!-- Top Badges & Meta -->\n<div class=\"flex flex-wrap items-center justify-between gap-4 mb-6\">\n<div class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-high text-primary font-label-md text-label-md tracking-wider uppercase\">\n<span class=\"w-2 h-2 rounded-full bg-cedar-gold animate-pulse\"></span>\n<span>Accommodation • The Seven Energy Centers • 7,500 FT Elevation</span>\n</div>\n<div class=\"flex items-center gap-3 text-pine-muted font-label-md text-label-md\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] text-cedar-gold\">filter_hdr</span>\n<span>Garhwal Range View • Snow Crest North</span>\n</div>\n</div>\n<!-- Main Heading with Sliding Editorial Reveal -->\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-12\">\n<div class=\"lg:col-span-8\">\n<span class=\"text-cedar-gold font-label-lg text-label-lg tracking-widest uppercase block mb-3\">Sahasrara &amp; Anahata Sanctuary</span>\n<h1 class=\"font-headline-lg text-headline-lg lg:text-[52px] lg:leading-[60px] text-primary max-w-4xl tracking-tight\">\n            Celebrating the unity that lies within, forever entwined and inseparable.\n          </h1>\n</div>\n<div class=\"lg:col-span-4 flex flex-col gap-4\">\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n            Inspired by the body’s seven energy centers “CHAKRAS”, we here at Light of Landour want to create an atmosphere of harmony and balance for all who visit. Experience the energy of divinity by surrendering identity.\n          </p>\n<div class=\"flex items-center gap-4 pt-2\">\n<a class=\"inline-flex items-center justify-center px-6 py-3 bg-pine-deep text-linen-base font-label-md text-label-md uppercase tracking-wider rounded-lg shadow-sm hover:bg-pine-muted transition-all duration-300\" href=\"#reservation-suite\">\n              Check Availability\n            </a>\n<button data-photo-tour=\"\" aria-label=\"Explore photo tour\" class=\"inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-surface-container text-primary font-label-md text-label-md tracking-wider uppercase hover:bg-surface-container-high transition-colors\" type=\"button\"><span class=\"material-symbols-outlined\" aria-hidden=\"true\">photo_library</span><span>Explore photo tour</span></button>\n</div>\n</div>\n</div>\n<!-- Floating Architectural Specs Bar -->\n<div class=\"w-full bg-surface-container-lowest rounded-xl shadow-[0_12px_32px_-12px_rgba(22,26,29,0.06)] p-5 lg:p-6\">\n<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 divide-y lg:divide-y-0 lg:divide-x divide-transparent\">\n<div class=\"flex flex-col gap-1 pr-4\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-mist-silver\">Occupancy</span>\n<span class=\"font-title-md text-title-md text-slate-charcoal\">2 Adults &amp; Children</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Attic extra bedding on request</span>\n</div>\n<div class=\"flex flex-col gap-1 pt-4 md:pt-0 lg:px-4\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-mist-silver\">Master Bed</span>\n<span class=\"font-title-md text-title-md text-slate-charcoal\">1 King Size Cedar Bed</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">Heated woolen spread</span>\n</div>\n<div class=\"flex flex-col gap-1 pt-4 md:pt-0 lg:px-4\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-mist-silver\">Suite Geometry</span>\n<span class=\"font-title-md text-title-md text-slate-charcoal\">Bedroom + Attic Nook</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">12 x 20 sq. ft. living area</span>\n</div>\n<div class=\"flex flex-col gap-1 pt-4 lg:pt-0 lg:px-4\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-mist-silver\">Outdoor Living</span>\n<span class=\"font-title-md text-title-md text-slate-charcoal\">Courtyard &amp; Balcony</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">10x10 Courtyard + 6x10 Balcony</span>\n</div>\n<div class=\"flex flex-col gap-1 pt-4 lg:pt-0 lg:pl-4\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-mist-silver\">Nightly Offering</span>\n<div class=\"flex items-baseline gap-1\">\n<span class=\"font-headline-sm text-headline-sm text-pine-deep font-semibold\">₹11,500</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">/ night + taxes</span>\n</div>\n<span class=\"font-label-sm text-label-sm text-cedar-gold uppercase tracking-wider\">Breakfast Included</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- SECTION 2: AUDIO-VISUAL SANCTUARY & 4K TOUR PREVIEW -->\n<section class=\"w-full bg-surface py-16 lg:py-24\" id=\"video-sanctuary\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4\">\n<div>\n<span class=\"text-label-md font-label-md uppercase tracking-widest text-cedar-gold block mb-2\">Cinematic Preview</span>\n<h2 class=\"font-headline-md text-headline-md text-primary\">The Mist, The Chimes &amp; Prana — Audio-Visual Sanctuary</h2>\n</div>\n<div class=\"flex items-center gap-3\">\n<span class=\"px-3 py-1 bg-surface-container rounded-full text-label-sm font-label-sm uppercase tracking-wider text-pine-muted flex items-center gap-1.5\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[14px] text-cedar-gold\">surround_sound</span>\n            432Hz Himalayan Singing Bowls\n          </span>\n<span class=\"px-3 py-1 bg-pine-deep text-linen-base rounded-full text-label-sm font-label-sm tracking-wider uppercase font-semibold\">4K HDR</span>\n</div>\n</div>\n<!-- Video Player Frame with Realistic Himalayan Ambience -->\n<div class=\"relative w-full aspect-[16/9] max-h-[640px] rounded-2xl overflow-hidden shadow-2xl bg-slate-charcoal group\">\n<div class=\"absolute inset-0 bg-cover bg-center transition-transform duration-1000 group-hover:scale-105\" data-alt=\"Expansive panoramic view of Landour deodar forest and mist creeping through the pine valley under soft warm golden hour light with majestic snow peaks of Garhwal Himalayas in background\" style=\"background-image: url('/assets/b249a346b4d58796.webp')\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-t from-slate-charcoal via-slate-charcoal/30 to-transparent opacity-80\"></div>\n<!-- Center Play Button with Pulsing Wave -->\n<div class=\"absolute inset-0 flex flex-col items-center justify-center pointer-events-none\">\n<div class=\"w-20 h-20 rounded-full bg-linen-base/90 backdrop-blur-md shadow-xl flex items-center justify-center transition-transform duration-300 group-hover:scale-110 pointer-events-auto cursor-pointer\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-primary text-[36px] ml-1\" style=\"font-variation-settings: 'FILL' 1;\">play_arrow</span>\n</div>\n<span class=\"mt-4 font-label-md text-label-md uppercase tracking-widest text-linen-base text-shadow\">Chakra Rooms at Dawn — 7,500 ft Above Sea Level</span>\n</div>\n<!-- Custom Video Player Controller Bar -->\n<div class=\"absolute bottom-0 inset-x-0 p-6 flex flex-col gap-3 bg-gradient-to-t from-slate-charcoal/90 to-transparent\">\n<div class=\"w-full h-1 bg-linen-base/20 rounded-full overflow-hidden cursor-pointer\">\n<div class=\"h-full bg-cedar-gold w-[38%] rounded-full\"></div>\n</div>\n<div class=\"flex items-center justify-between text-linen-base\">\n<div class=\"flex items-center gap-4\">\n<button data-photo-tour=\"\" aria-label=\"Explore photo tour\" type=\"button\" class=\"hover:text-amber-gold-bright transition-colors\"><span class=\"material-symbols-outlined\" aria-hidden=\"true\">photo_library</span></button>\n\n<span class=\"font-body-sm text-body-sm text-linen-base/80\">Sanctuary photo collection</span>\n</div>\n<div class=\"flex items-center gap-4\">\n<span class=\"hidden sm:inline font-label-sm text-label-sm uppercase tracking-widest text-linen-base/70\">Char Dukan Ridge</span>\n\n<button data-photo-tour=\"\" aria-label=\"Explore photo tour\" type=\"button\" class=\"hover:text-amber-gold-bright transition-colors\"><span class=\"material-symbols-outlined\" aria-hidden=\"true\">photo_library</span></button>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- SECTION 3: FEATURED CHAKRA SUITE ARCHITECTURE & DUAL PANELS -->\n<section class=\"w-full bg-linen-subtle py-16 lg:py-24\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n<!-- Visual Gallery Mosaic -->\n<div class=\"lg:col-span-7 flex flex-col gap-6\">\n<div class=\"relative rounded-2xl overflow-hidden shadow-xl aspect-[16/10] bg-surface-container\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/76f343fcc29303a5-480.webp 480w, /assets/76f343fcc29303a5-960.webp 960w, /assets/76f343fcc29303a5.webp 1408w\" height=\"768\" width=\"1408\" fetchpriority=\"high\" decoding=\"async\" loading=\"eager\" class=\"w-full h-full object-cover transition-transform duration-700 hover:scale-105\" data-alt=\"Chakra Room suite at Light of Landour with expansive panoramic glass wall framing snow peaks, warm timber walls, Tibetan chakra wall hanging, plush bed with ochre and turquoise throws, cane armchair and morning tea table\" src=\"/assets/76f343fcc29303a5.webp\">\n<div class=\"absolute top-4 left-4 bg-linen-base/90 backdrop-blur-md px-4 py-1.5 rounded-full text-label-sm font-label-sm uppercase tracking-wider text-pine-deep font-semibold\">\n              Master Chamber • Sahasrara Aura\n            </div>\n</div>\n<div class=\"grid grid-cols-2 gap-6\">\n<div class=\"relative rounded-xl overflow-hidden shadow-md aspect-[4/3] bg-surface-container\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/4eda7b0657110fd7-480.webp 480w, /assets/4eda7b0657110fd7-960.webp 960w, /assets/4eda7b0657110fd7.webp 1408w\" height=\"768\" width=\"1408\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover transition-transform duration-700 hover:scale-105\" data-alt=\"Cozy Himalayan reading attic and sitting courtyard with reclaimed cedar wood, leather armchair, brass singing bowl, and soft mountain light filtering through pine trees\" src=\"/assets/4eda7b0657110fd7.webp\">\n<div class=\"absolute bottom-3 left-3 bg-slate-charcoal/80 text-linen-base px-3 py-1 rounded-md text-label-sm font-label-sm\">Private Attic Nook</div>\n</div>\n<div class=\"relative rounded-xl overflow-hidden shadow-md aspect-[4/3] bg-surface-container\">\n<img sizes=\"(max-width: 767px) 100vw, (max-width: 1100px) 65vw, 1100px\" srcset=\"/assets/583b169874734307-480.webp 480w, /assets/583b169874734307-960.webp 960w, /assets/583b169874734307.webp 1408w\" height=\"768\" width=\"1408\" decoding=\"async\" loading=\"lazy\" class=\"w-full h-full object-cover transition-transform duration-700 hover:scale-105\" data-alt=\"Porcelain cup of hot masala chai resting on a wooden balcony railing overlooking misty rolling pine trees and Himalayan hillside of Landour Char Dukan\" src=\"/assets/583b169874734307.webp\">\n<div class=\"absolute bottom-3 left-3 bg-slate-charcoal/80 text-linen-base px-3 py-1 rounded-md text-label-sm font-label-sm\">Morning Tea on Balcony</div>\n</div>\n</div>\n</div>\n<!-- Suite Story & Architectural Specifications -->\n<div class=\"lg:col-span-5 flex flex-col gap-6\">\n<span class=\"text-cedar-gold font-label-lg text-label-lg uppercase tracking-widest\">Sanctuary Architecture</span>\n<h2 class=\"font-headline-lg text-headline-lg text-primary leading-tight\">Unparalleled Seclusion &amp; Privacy with Himalayan Vistas</h2>\n<div class=\"flex flex-col gap-3 font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n<p>\n              Experience a level of privacy that exceeds expectations, accompanied by unparalleled spaciousness, all within the breathtaking embrace of nature's wonders. Whether you seek solitude for personal reflection or a serene environment for cherished moments with loved ones, our sanctuary offers a sanctuary of peace.\n            </p>\n<p>\n              Each room on this floor is designed and dedicated to one of the energy chakras as you walk past the centralized balcony you experience the heightened need to explore self.\n            </p>\n</div>\n<!-- Dimension Matrix Cards -->\n<div class=\"grid grid-cols-2 gap-3 pt-2\">\n<div class=\"bg-linen-base p-4 rounded-xl shadow-sm\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-cedar-gold text-[20px] mb-1\">aspect_ratio</span>\n<div class=\"font-label-sm text-label-sm uppercase tracking-wider text-mist-silver\">Master Suite</div>\n<div class=\"font-title-md text-title-md text-primary\">12 × 20 sq. ft.</div>\n</div>\n<div class=\"bg-linen-base p-4 rounded-xl shadow-sm\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-cedar-gold text-[20px] mb-1\">deck</span>\n<div class=\"font-label-sm text-label-sm uppercase tracking-wider text-mist-silver\">Courtyard Space</div>\n<div class=\"font-title-md text-title-md text-primary\">10 × 10 sq. ft.</div>\n</div>\n<div class=\"bg-linen-base p-4 rounded-xl shadow-sm\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-cedar-gold text-[20px] mb-1\">balcony</span>\n<div class=\"font-label-sm text-label-sm uppercase tracking-wider text-mist-silver\">Valley Balcony</div>\n<div class=\"font-title-md text-title-md text-primary\">6 × 10 sq. ft.</div>\n</div>\n<div class=\"bg-linen-base p-4 rounded-xl shadow-sm\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-cedar-gold text-[20px] mb-1\">bathtub</span>\n<div class=\"font-label-sm text-label-sm uppercase tracking-wider text-mist-silver\">Ensuite Bath</div>\n<div class=\"font-title-md text-title-md text-primary\">6 × 9 sq. ft.</div>\n</div>\n</div>\n<!-- Creature Comforts -->\n<div class=\"p-4 rounded-xl bg-surface-container-high text-on-surface\">\n<div class=\"font-label-md text-label-md uppercase tracking-wider text-pine-deep mb-2 flex items-center gap-2\">\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[18px]\">tune</span>\n              In-Room Ergonomics &amp; Comfort\n            </div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-normal\">\n              Flat-screen television, accessible multi-pin device charging ports, bespoke timber wardrobe, luggage rack, and artisanal chest of drawers. Spacious attached restrooms on both levels maintained with organic forest botanicals.\n            </p>\n</div>\n<div class=\"flex items-center justify-between pt-2\">\n<div>\n<span class=\"font-label-sm text-label-sm uppercase text-mist-silver block\">Tariff</span>\n<span class=\"font-headline-sm text-headline-sm text-pine-deep\">From ₹11,500 <span class=\"font-body-sm text-body-sm font-normal text-on-surface-variant\">/ night</span></span>\n</div>\n<a class=\"px-6 py-3 bg-pine-deep text-linen-base font-label-md text-label-md uppercase tracking-wider rounded-lg shadow hover:bg-pine-muted transition-colors\" href=\"#reservation-suite\">\n              Reserve Chakra Suite\n            </a>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- SECTION 4: THE SEVEN ENERGY CENTERS (CHAKRA EXPLORATION GRID) -->\n<section class=\"w-full bg-linen-base py-16 lg:py-24\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"text-center max-w-3xl mx-auto mb-16\">\n<span class=\"text-label-md font-label-md uppercase tracking-widest text-cedar-gold block mb-2\">Explore For Inspiration</span>\n<h2 class=\"font-headline-lg text-headline-lg text-primary mb-4\">The Seven Energy Centers of Landour</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n          Each suite corridor and meditative vantage point is oriented along the seven energy vortexes, designed to evoke tranquility, balance, and mindful presence.\n        </p>\n</div>\n<!-- 7 Chakra Energy Bento Cards -->\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6\">\n<!-- 1. Muladhara -->\n<div class=\"p-6 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group\">\n<div>\n<div class=\"flex items-center justify-between mb-4\">\n<span class=\"w-10 h-10 rounded-full bg-error-container/30 text-error flex items-center justify-center font-headline-sm text-headline-sm\">\n                १\n              </span>\n<span class=\"px-3 py-1 rounded-full bg-surface-container text-label-sm font-label-sm text-on-surface-variant uppercase\">Earth</span>\n</div>\n<h3 class=\"font-headline-sm text-headline-sm text-primary mb-2\">Muladhara</h3>\n<span class=\"text-label-md font-label-md text-cedar-gold uppercase tracking-wider block mb-3\">Root Chakra</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-relaxed\">\n              Embracing the red hue, feel grounded and secure, both physically and emotionally. Anchored by the subterranean cedar foundations of Char Dukan.\n            </p>\n</div>\n<div class=\"mt-6 pt-4 flex items-center justify-between text-body-sm text-pine-muted\">\n<span>Grounding Suite</span>\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform\">arrow_forward</span>\n</div>\n</div>\n<!-- 2. Svadhishthana -->\n<div class=\"p-6 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group\">\n<div>\n<div class=\"flex items-center justify-between mb-4\">\n<span class=\"w-10 h-10 rounded-full bg-secondary-fixed/50 text-secondary flex items-center justify-center font-headline-sm text-headline-sm\">\n                २\n              </span>\n<span class=\"px-3 py-1 rounded-full bg-surface-container text-label-sm font-label-sm text-on-surface-variant uppercase\">Water</span>\n</div>\n<h3 class=\"font-headline-sm text-headline-sm text-primary mb-2\">Svadhishthana</h3>\n<span class=\"text-label-md font-label-md text-cedar-gold uppercase tracking-wider block mb-3\">Sacral Chakra</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-relaxed\">\n              Observing the orange hue, enhance self-worth, feel more vibrant, satisfied, compassionate, and intuitive. Oriented toward warm dawn horizons.\n            </p>\n</div>\n<div class=\"mt-6 pt-4 flex items-center justify-between text-body-sm text-pine-muted\">\n<span>Creative Flow</span>\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform\">arrow_forward</span>\n</div>\n</div>\n<!-- 3. Manipura -->\n<div class=\"p-6 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group\">\n<div>\n<div class=\"flex items-center justify-between mb-4\">\n<span class=\"w-10 h-10 rounded-full bg-secondary-container/40 text-on-secondary-container flex items-center justify-center font-headline-sm text-headline-sm\">\n                ३\n              </span>\n<span class=\"px-3 py-1 rounded-full bg-surface-container text-label-sm font-label-sm text-on-surface-variant uppercase\">Fire</span>\n</div>\n<h3 class=\"font-headline-sm text-headline-sm text-primary mb-2\">Manipura</h3>\n<span class=\"text-label-md font-label-md text-cedar-gold uppercase tracking-wider block mb-3\">Solar Plexus Chakra</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-relaxed\">\n              Reflecting the hue of yellow, balancing self-esteem, being productive and focused. Infused with noon Himalayan sun on the courtyard stone.\n            </p>\n</div>\n<div class=\"mt-6 pt-4 flex items-center justify-between text-body-sm text-pine-muted\">\n<span>Vitality Room</span>\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform\">arrow_forward</span>\n</div>\n</div>\n<!-- 4. Anahata -->\n<div class=\"p-6 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group\">\n<div>\n<div class=\"flex items-center justify-between mb-4\">\n<span class=\"w-10 h-10 rounded-full bg-primary-fixed text-pine-deep flex items-center justify-center font-headline-sm text-headline-sm\">\n                ४\n              </span>\n<span class=\"px-3 py-1 rounded-full bg-surface-container text-label-sm font-label-sm text-on-surface-variant uppercase\">Air</span>\n</div>\n<h3 class=\"font-headline-sm text-headline-sm text-primary mb-2\">Anahata</h3>\n<span class=\"text-label-md font-label-md text-cedar-gold uppercase tracking-wider block mb-3\">Heart Chakra</span>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant leading-relaxed\">\n              Posing the green hue, harmonizing empathy, love, care for all and self. Opens wide to the endless emerald deodar pine canopies.\n            </p>\n</div>\n<div class=\"mt-6 pt-4 flex items-center justify-between text-body-sm text-pine-muted\">\n<span>Harmonious Center</span>\n<span aria-hidden=\"true\" class=\"material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform\">arrow_forward</span>\n</div>\n</div>\n<!-- 5. Vishuddha -->\n<div class=\"p-6 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group\">\n<div>\n<div class=\"flex items-center justify-between mb-4\">\n<span class=\"w-10 h-10 rounded-full bg-surface-tint/20 text-pine-deep flex items-center justify-center font-headline-sm text-headline-sm\">\n   