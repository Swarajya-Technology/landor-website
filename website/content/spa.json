  "html": "<main id=\"main-content\" class=\"w-full pt-28 bg-surface\"><div class=\"flex flex-col w-full\">\n<!-- Immersive Mountain Hero Section -->\n<section class=\"relative w-full -mt-28 min-h-[92vh] flex flex-col justify-between overflow-hidden bg-primary\">\n<!-- Hero Scrim & Generated Background Image -->\n<div class=\"absolute inset-0 w-full h-full bg-cover bg-center transition-transform duration-1000 ease-out scale-105\" data-alt=\"An expansive panoramic high-altitude Himalayan luxury outdoor spa deck at Light of Landour, featuring a steaming cedarwood hot tub, brass singing bowls on raw slate, a glass spa pavilion with warm interior glow, and majestic snowcapped Himalayan peaks under a radiant golden sunrise mist in pine tones #1B3B2B and warm linen #FBF9F5.\" style=\"background-image: url('/assets/67a1c9c0163c4ed7.webp')\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-t from-primary via-primary/60 to-primary/40 mix-blend-multiply\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-r from-primary/80 via-transparent to-primary/50\"></div>\n<!-- Hero Content Overlay clearing shell header -->\n<div class=\"relative z-10 max-w-[1320px] w-full mx-auto px-6 pt-44 pb-16 flex flex-col justify-end flex-grow\">\n<!-- Top Sanctuary Location Pills -->\n<div class=\"flex flex-wrap items-center gap-3 mb-8\">\n<span class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-bright/15 backdrop-blur-md text-linen-base font-label-md text-label-md tracking-widest uppercase border-none shadow-sm\">\n<span class=\"w-2 h-2 rounded-full bg-cedar-gold animate-pulse\"></span>\n          Sanctuary Elevation: 7,500 FT\n        </span>\n<span class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-bright/10 backdrop-blur-md text-linen-base/90 font-label-md text-label-md tracking-wider uppercase\">\n<span class=\"material-symbols-outlined text-[14px] text-cedar-gold\">location_on</span>\n          Char Dukan Ridge\n        </span>\n<span class=\"inline-flex items-center px-3 py-1.5 rounded-full bg-cedar-gold text-on-secondary-fixed font-label-sm text-label-sm tracking-widest uppercase font-bold\">\n          Coming Soon — Summer 2025 Unveiling\n        </span>\n</div>\n<!-- Headline Typography Hierarchy -->\n<div class=\"max-w-4xl space-y-4\">\n<span class=\"font-display italic text-headline-md text-amber-gold-bright block tracking-wide\">\n          The Himalayan Spa &amp; Restorative Sanctuary\n        </span>\n<h1 class=\"font-headline-lg text-display text-on-primary tracking-tight leading-[1.05]\">\n          Awaken the Sacred Prana\n        </h1>\n<p class=\"font-body-lg text-body-lg text-surface-container-low max-w-2xl leading-relaxed pt-2\">\n          Rising above the daily mayhem, feeling the pulse of pure deodar woodland, breathing crisp high-altitude air. An intimate Himalayan sanctuary where ancient Ayurvedic science, Tibetan singing bowl acoustics, and wild alpine botanicals harmonize to restore spirit, mind, and earthly vitality.\n        </p>\n</div>\n<!-- Hero Actions & Waitlist Trigger -->\n<div class=\"flex flex-wrap items-center gap-4 pt-8\">\n<a class=\"inline-flex items-center gap-3 px-8 py-3.5 bg-cedar-gold text-on-secondary-fixed font-label-lg text-label-lg uppercase tracking-wider rounded-lg shadow-lg hover:bg-amber-gold-bright transition-all duration-300\" href=\"#waitlist\">\n<span>Priority Sanctuary Waitlist</span>\n<span class=\"material-symbols-outlined text-[18px]\">north_east</span>\n</a>\n<a class=\"inline-flex items-center gap-3 px-7 py-3.5 bg-surface-bright/10 hover:bg-surface-bright/20 backdrop-blur-md text-linen-base font-label-lg text-label-lg uppercase tracking-wider rounded-lg transition-all duration-300\" href=\"#rituals\">\n<span>Explore Preview Rituals</span>\n<span class=\"material-symbols-outlined text-[18px]\">arrow_downward</span>\n</a>\n</div>\n</div>\n<!-- Sanctuary Quick Metrics Horizontal Strip -->\n<div class=\"relative z-10 w-full bg-slate-charcoal/90 backdrop-blur-xl py-6\">\n<div class=\"max-w-[1320px] mx-auto px-6 grid grid-cols-2 lg:grid-cols-4 gap-6\">\n<div class=\"flex flex-col gap-1\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-cedar-gold\">Sanctuary Altitude</span>\n<span class=\"font-title-lg text-title-lg text-linen-base\">7,500 FT Above Clouds</span>\n<span class=\"font-body-sm text-body-sm text-mist-silver\">Overlooking Doon Valley &amp; Pines</span>\n</div>\n<div class=\"flex flex-col gap-1\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-cedar-gold\">Ancient Healing</span>\n<span class=\"font-title-lg text-title-lg text-linen-base\">12 Signature Modalities</span>\n<span class=\"font-body-sm text-body-sm text-mist-silver\">Garhwal Stones &amp; Tibetan Bowls</span>\n</div>\n<div class=\"flex flex-col gap-1\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-cedar-gold\">Thermal Architecture</span>\n<span class=\"font-title-lg text-title-lg text-linen-base\">Heated Cedar Hot Tubs</span>\n<span class=\"font-body-sm text-body-sm text-mist-silver\">Wild Rhododendron &amp; Pine Infusions</span>\n</div>\n<div class=\"flex flex-col gap-1\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-cedar-gold\">VIP Access</span>\n<span class=\"font-title-lg text-title-lg text-linen-base\">Solstice 2025 Opening</span>\n<span class=\"font-body-sm text-body-sm text-mist-silver\">Curated Stays &amp; Silent Lodging</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Narrative Poetics / Sanctuary Philosophy -->\n<section class=\"w-full py-24 bg-linen-base\">\n<div class=\"max-w-[1320px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n<div class=\"lg:col-span-5 flex flex-col space-y-6\">\n<div class=\"flex items-center gap-3\">\n<span class=\"h-[1px] w-8 bg-cedar-gold\"></span>\n<span class=\"font-label-md text-label-md uppercase tracking-widest text-pine-deep font-semibold\">Living Stillness</span>\n</div>\n<h2 class=\"font-headline-lg text-headline-lg text-slate-charcoal\">\n          A temple of deceleration framed by clouds and century-old deodars.\n        </h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n          At Landour’s highest crest, silence is an acoustic medicine. The Light of Landour Himalayan Sanctuary has been envisioned as an oasis of sensory surrender. Every treatment pavilion is crafted using reclaimed pine, sun-warmed slate, and uninterrupted floor-to-ceiling vistas of the snow-clad Kedarnath and Chaukhamba range.\n        </p>\n<div class=\"p-6 bg-linen-subtle rounded-xl shadow-sm flex flex-col space-y-3\">\n<div class=\"flex items-center gap-3 text-pine-deep\">\n<span class=\"material-symbols-outlined text-cedar-gold\">self_improvement</span>\n<span class=\"font-title-md text-title-md font-semibold\">The Sattvic Alpine Standard</span>\n</div>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">\n            Zero chemical synthesis. Cold-pressed Himalayan cedarwood, pure stone salt harvested from Tehri waters, and seasonal infusions prepared fresh each dawn by our resident Vaidya.\n          </p>\n</div>\n</div>\n<!-- Architectural Showcase Grid -->\n<div class=\"lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-6\">\n<div class=\"relative rounded-xl overflow-hidden shadow-md group\">\n<img fetchpriority=\"high\" decoding=\"async\" loading=\"eager\" alt=\"Duplex suite overlooking misty mountains\" class=\"w-full h-80 object-cover group-hover:scale-105 transition-transform duration-700 ease-out\" src=\"/assets/71e6d12c9d8d73d0.webp\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-slate-charcoal/90 via-transparent to-transparent flex flex-col justify-end p-6\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-cedar-gold\">Restorative Quarters</span>\n<span class=\"font-headline-sm text-headline-sm text-linen-base\">Duplex Meditation Lounges</span>\n<span class=\"font-body-sm text-body-sm text-mist-silver\">Private timber balconies facing snow lines</span>\n</div>\n</div>\n<div class=\"relative rounded-xl overflow-hidden shadow-md group md:translate-y-8\">\n<img decoding=\"async\" loading=\"lazy\" alt=\"Warm timber interior sanctuary with expansive panoramic glass\" class=\"w-full h-80 object-cover group-hover:scale-105 transition-transform duration-700 ease-out\" src=\"/assets/1f41f6d2a61e11fa.webp\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-slate-charcoal/90 via-transparent to-transparent flex flex-col justify-end p-6\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider text-cedar-gold\">Chakra &amp; Mudra Design</span>\n<span class=\"font-headline-sm text-headline-sm text-linen-base\">Glass-Walled Healing Suites</span>\n<span class=\"font-body-sm text-body-sm text-mist-silver\">Warm pine paneling &amp; pure morning solar warmth</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Acoustic & Sensory Immersion — The Breath of the Pines Video/Audio Module -->\n<section class=\"w-full py-20 bg-primary-container text-on-primary\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12\">\n<div class=\"space-y-3 max-w-2xl\">\n<span class=\"font-label-md text-label-md uppercase tracking-widest text-cedar-gold\">Auditory Resonance</span>\n<h2 class=\"font-headline-lg text-headline-lg text-linen-base\">\n            The Breath of the Pines: Acoustic Immersion\n          </h2>\n<p class=\"font-body-md text-body-md text-on-primary-container\">\n            Preview the tranquility awaiting your senses. Tuned to 528Hz Solfeggio frequency and blended with natural deodar breezes, Himalayan wind chimes, and flowing spring waters.\n          </p>\n</div>\n<div class=\"flex items-center gap-2 bg-slate-charcoal/60 px-4 py-2 rounded-full\">\n<span class=\"w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-linen-base\">4K HDR • 528Hz Solfeggio Soundscape</span>\n</div>\n</div>\n<!-- Cinematic Mountain Video Player Container -->\n<div class=\"relative w-full rounded-2xl overflow-hidden shadow-2xl bg-slate-charcoal aspect-video max-h-[580px] group\">\n<div class=\"absolute inset-0 w-full h-full bg-cover bg-center transition-transform duration-1000 group-hover:scale-102\" data-alt=\"Cinematic frame showing tranquil mist weaving through emerald green deodar pine trees in Landour with golden mountain sunshine reflecting on a stone water feature, meditative serene mood.\" style=\"background-image: url('/assets/baabec2fc6e39ac8.webp')\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-t from-slate-charcoal via-slate-charcoal/40 to-transparent\"></div>\n<!-- Center Glowing Play Button -->\n<div class=\"absolute inset-0 flex items-center justify-center\">\n<button type=\"button\" aria-label=\"Play Himalayan Soundscape\" class=\"relative flex items-center justify-center w-24 h-24 rounded-full bg-cedar-gold text-slate-charcoal shadow-2xl hover:scale-110 hover:bg-amber-gold-bright transition-all duration-300 group-hover:ring-8 group-hover:ring-cedar-gold/20\" id=\"audio-preview-btn\">\n<span class=\"material-symbols-outlined text-[44px] ml-1\" id=\"play-icon\" style=\"font-variation-settings: 'FILL' 1;\">play_arrow</span>\n</button>\n</div>\n<!-- Custom Player Bottom Bar -->\n<div class=\"absolute bottom-0 inset-x-0 p-6 md:p-8 flex flex-col gap-4 bg-gradient-to-t from-slate-charcoal via-slate-charcoal/80 to-transparent\">\n<!-- Sound wave graphic bar -->\n<div class=\"w-full flex items-center gap-1.5 h-8\">\n<span class=\"w-1.5 h-3 bg-cedar-gold/60 rounded-full animate-[pulse_1.2s_infinite]\"></span>\n<span class=\"w-1.5 h-5 bg-cedar-gold/80 rounded-full animate-[pulse_0.9s_infinite]\"></span>\n<span class=\"w-1.5 h-8 bg-cedar-gold rounded-full animate-[pulse_1.4s_infinite]\"></span>\n<span class=\"w-1.5 h-4 bg-cedar-gold/70 rounded-full animate-[pulse_1.1s_infinite]\"></span>\n<span class=\"w-1.5 h-6 bg-cedar-gold/90 rounded-full animate-[pulse_1.3s_infinite]\"></span>\n<span class=\"w-1.5 h-2 bg-cedar-gold/40 rounded-full animate-[pulse_0.8s_infinite]\"></span>\n<div class=\"flex-grow h-1.5 bg-surface-container-high/30 rounded-full overflow-hidden mx-2\">\n<div class=\"w-2/5 h-full bg-cedar-gold rounded-full transition-all duration-300\" id=\"playback-bar\"></div>\n</div>\n<span class=\"font-label-sm text-label-sm text-linen-base font-mono\">02:45 / 06:10</span>\n</div>\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-cedar-gold\">graphic_eq</span>\n<span class=\"font-body-sm text-body-sm text-linen-base\">Tibetan Bell Resonance &amp; Dawn Valley Chorus</span>\n</div>\n<div class=\"flex items-center gap-4 text-linen-base\">\n<button aria-label=\"volume_up\" type=\"button\" class=\"hover:text-cedar-gold transition-colors\" title=\"Audio Stream\"><span class=\"material-symbols-outlined text-[20px]\">volume_up</span></button>\n<button aria-label=\"fullscreen\" type=\"button\" class=\"hover:text-cedar-gold transition-colors\" title=\"Full Frame\"><span class=\"material-symbols-outlined text-[20px]\">fullscreen</span></button>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Upcoming Signature Himalayan Wellness Offerings (Preview Rituals) -->\n<section class=\"w-full py-28 bg-surface\" id=\"rituals\">\n<div class=\"max-w-[1320px] mx-auto px-6\">\n<div class=\"flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6\">\n<div class=\"space-y-3 max-w-2xl\">\n<span class=\"font-label-md text-label-md uppercase tracking-widest text-cedar-gold\">Curated Modalities</span>\n<h2 class=\"font-headline-lg text-headline-lg text-slate-charcoal\">\n            Signature Himalayan Rituals\n          </h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">\n            Each restorative offering channels mountain elements: wild cedar resins, heated river rocks, vibrational singing bowls, and the pure breath of deodar canopies.\n          </p>\n</div>\n<div class=\"hidden sm:flex items-center gap-3\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant\">4 Modalities Available for Preview Booking</span>\n</div>\n</div>\n<!-- 4-Card Luxury Grid -->\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\">\n<!-- Ritual Card 1 -->\n<div class=\"group bg-linen-subtle rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col justify-between\">\n<div>\n<div class=\"relative aspect-[4/3] overflow-hidden\">\n<div class=\"w-full h-full bg-cover bg-center group-hover:scale-105 transition-transform duration-700\" data-alt=\"An Ayurvedic hot stone massage in a luxury Himalayan timber room with mountain views, warm polished Garhwal river rocks, fragrant steaming herbal oils, fresh rhododendron petals, soft candle glow, serene atmosphere.\" style=\"background-image: url('/assets/22c8f4a5f464d782.webp')\"></div>\n<span class=\"absolute top-4 left-4 px-3 py-1 bg-slate-charcoal/80 backdrop-blur-md rounded-full text-linen-base font-label-sm text-label-sm uppercase tracking-wider\">\n                Earth &amp; Heat\n              </span>\n</div>\n<div class=\"p-6 space-y-3\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-cedar-gold\">Signature Body Therapy</span>\n<h3 class=\"font-headline-md text-headline-sm text-slate-charcoal group-hover:text-pine-deep transition-colors\">\n                Himalayan Cedar &amp; Hot Stone Prana\n              </h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant line-clamp-3\">\n                Deep somatic release utilizing hand-picked smooth stones from the pristine Garhwal riverbeds, infused with wild Himalayan cedarwood resin and warm sesame oil.\n              </p>\n</div>\n</div>\n<div class=\"px-6 pb-6 pt-2 flex items-center justify-between\">\n<span class=\"font-label-md text-label-md font-semibold text-pine-deep\">90 Minutes</span>\n<a class=\"inline-flex items-center gap-1 font-label-sm text-label-sm uppercase tracking-wider text-cedar-gold hover:text-pine-deep transition-colors\" href=\"#waitlist\">\n              Reserve First <span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</a>\n</div>\n</div>\n<!-- Ritual Card 2 -->\n<div class=\"group bg-linen-subtle rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col justify-between\">\n<div>\n<div class=\"relative aspect-[4/3] overflow-hidden\">\n<div class=\"w-full h-full bg-cover bg-center group-hover:scale-105 transition-transform duration-700\" data-alt=\"Handcrafted Tibetan brass singing bowls lined along an aged cedarwood deck in the Himalayas with morning mist and soft ambient light, spiritual meditation setup.\" style=\"background-image: url('/assets/72c2b5782f5fe4ef.webp')\"></div>\n<span class=\"absolute top-4 left-4 px-3 py-1 bg-slate-charcoal/80 backdrop-blur-md rounded-full text-linen-base font-label-sm text-label-sm uppercase tracking-wider\">\n                Akasha &amp; Vibration\n              </span>\n</div>\n<div class=\"p-6 space-y-3\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-cedar-gold\">Acoustic Alignment</span>\n<h3 class=\"font-headline-md text-headline-sm text-slate-charcoal group-hover:text-pine-deep transition-colors\">\n                Dawn Tibetan Singing Bowl Bath\n              </h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant line-clamp-3\">\n                Seven chakra multi-metal bowls struck at golden hour overlooking the Chaukhamba peaks. Harmonic frequencies penetrate deep cellular frequencies to clear stagnant prana.\n              </p>\n</div>\n</div>\n<div class=\"px-6 pb-6 pt-2 flex items-center justify-between\">\n<span class=\"font-label-md text-label-md font-semibold text-pine-deep\">75 Minutes</span>\n<a class=\"inline-flex items-center gap-1 font-label-sm text-label-sm uppercase tracking-wider text-cedar-gold hover:text-pine-deep transition-colors\" href=\"#waitlist\">\n              Reserve First <span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</a>\n</div>\n</div>\n<!-- Ritual Card 3 -->\n<div class=\"group bg-linen-subtle rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col justify-between\">\n<div>\n<div class=\"relative aspect-[4/3] overflow-hidden\">\n<div class=\"w-full h-full bg-cover bg-center group-hover:scale-105 transition-transform duration-700\" data-alt=\"Ancient deodar pine forest trail in Landour with dappled morning sunlight filtering through misty tall trees and stone walking path, silent contemplative nature atmosphere.\" style=\"background-image: url('/assets/73bc600b80008fa7.webp')\"></div>\n<span class=\"absolute top-4 left-4 px-3 py-1 bg-slate-charcoal/80 backdrop-blur-md rounded-full text-linen-base font-label-sm text-label-sm uppercase tracking-wider\">\n                Vayu &amp; Mindfulness\n              </span>\n</div>\n<div class=\"p-6 space-y-3\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-cedar-gold\">Forest Immersion</span>\n<h3 class=\"font-headline-md text-headline-sm text-slate-charcoal group-hover:text-pine-deep transition-colors\">\n                Shinrin-Yoku Forest Bathing\n              </h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant line-clamp-3\">\n                Mindful, silent botanical walks through Jabarkhet Reserve and Char Dukan forest ridges with botanist-curated herbal tisanes and grounding sensory techniques.\n              </p>\n</div>\n</div>\n<div class=\"px-6 pb-6 pt-2 flex items-center justify-between\">\n<span class=\"font-label-md text-label-md font-semibold text-pine-deep\">120 Minutes</span>\n<a class=\"inline-flex items-center gap-1 font-label-sm text-label-sm uppercase tracking-wider text-cedar-gold hover:text-pine-deep transition-colors\" href=\"#waitlist\">\n              Reserve First <span class=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n</a>\n</div>\n</div>\n<!-- Ritual Card 4 -->\n<div class=\"group bg-linen-subtle rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col justify-between\">\n<div>\n<div class=\"relative aspect-[4/3] overflow-hidden\">\n<div class=\"w-full h-full bg-cover bg-center group-hover:scale-105 transition-transform duration-700\" data-alt=\"A round handcrafted outdoor cedar hot tub steaming at dusk on a stone balcony with panoramic view of the Doon Valley mist below, Himalayan sunset colors in gold and amber.\" style=\"background-image: url('/assets/8581b64ee2dbd473.webp')\"></div>\n<span class=\"absolute top-4 left-4 px-3 py-1 bg-slate-charcoal/80 backdrop-blur-md rounded-full text-linen-base font-label-sm text-label-sm uppercase tracking-wider\">\n                Jala &amp; Springs\n              </span>\n</div>\n<div class=\"p-6 space-y-3\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-cedar-gold\">Hydro Thermal</span>\n<h3 class=\"font-headline-md text-headline-sm text-slate-charcoal group-hover:text-pine-deep transition-colors\">\n                Alpine Cedar Tubs &amp; Mist Springs\n              </h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant line-clamp-3\">\n                Deep soaking in raw cedarwood tubs scented with fresh rhododendron blossoms and wild mountain mint as sunset clouds drift through the surrounding pines.\n              </p>\n</div>\n</div>\n<div class=\"px-6 pb-6 pt-2 flex items-center justify-between\">\n<span class=\"font-label-md text-label-md font-semibold text-pine-deep\">60 Minutes</span>\n<a class=\"inline-flex items-center gap-1 font-label-sm text-label-sm uppercase tracking-wider text-cedar-gold hov